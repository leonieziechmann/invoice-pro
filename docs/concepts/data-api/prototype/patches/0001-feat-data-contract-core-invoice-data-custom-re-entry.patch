+
+/// The class of every `invoice()` parameter, for the re-entry of a hydrated
+/// call and for the signature test (tools/contract/signature.py), which fails
+/// when a parameter of `invoice()` is missing here:
+/// - "design": passed through unchanged, never data;
+/// - "document" / "issuer": the role of the format key of the same name
+///   (`objects.invoice.fields`);
+/// - "data", "body": the hydration source and the body.
+/// -> dictionary
+#let invoice-params = {
+  let roles = objects
+    .invoice
+    .fields
+    .pairs()
+    .filter(p => p.last().role != none)
+    .map(((k, f)) => (k, f.role))
+    .to-dict()
+  let fixed = (
+    theme: "design",
+    locale: "design",
+    references: "design",
+    zugferd: "design",
+    zugferd-errors: "design",
+    validation: "design",
+    tax-nr: "design",
+    data: "data",
+    body: "body",
+  )
+  fixed + roles
+}
diff --git a/src/contract/types.typ b/src/contract/types.typ
new file mode 100644
index 0000000..ab1b471
--- /dev/null
+++ b/src/contract/types.typ
@@ -0,0 +1,172 @@
+// The type vocabulary of the invoice data contract.
+//
+// ONE vocabulary describes the input format ("invoice-pro/1") and the result
+// ("invoice-pro-result/1"). Each constructor returns a plain dictionary
+// `(t: <kind>, ..)`; nothing here decodes or exports. Two interpreters read
+// the same descriptors: decode.typ turns parsed JSON/TOML/YAML into Typst
+// values and issues, export.typ writes a JSON Schema 2020-12 document.
+//
+// Internal: this module shadows `text`, `decimal`, `array` and friends of the
+// standard library (`t.text()` reads well in the descriptor); it must not call
+// the standard functions itself, and it is never re-exported (the public
+// namespace `invoice-data` shadows no builtin).
+
+/// A string. `max`: maximum length in characters (e.g. 35 for the
+/// structured payment reference of an EPC QR code). `pattern`: a regular
+/// expression the whole string must match, `pattern-doc` says it in words.
+/// -> dictionary
+#let text(max: none, pattern: none, pattern-doc: none, example: none) = (
+  t: "text",
+  max: max,
+  pattern: pattern,
+  pattern-doc: pattern-doc,
+  example: example,
+)
+
+/// A string, or an array of strings printed as lines (names, addresses).
+/// -> dictionary
+#let lines() = (t: "lines")
+
+/// An exact decimal number written as a string, `"12.30"`. JSON numbers are
+/// read too (converted exactly via their shortest representation), but the
+/// JSON Schema documents strings: a JSON number is a binary float.
+/// -> dictionary
+#let decimal(min: none, positive: false) = (
+  t: "decimal",
+  min: min,
+  positive: positive,
+)
+
+/// A percentage written as a string, `"19%"`, `"2.5%"`. Becomes a Typst
+/// ratio that equals the literal (`19%`) bit for bit.
+/// -> dictionary
+#let percent(min: none, max: none) = (t: "percent", min: min, max: max)
+
+/// An amount that is either absolute (a decimal, `"50.00"`) or relative (a
+/// percentage, `"10%"`): the `%` sign decides.
+/// -> dictionary
+#let amount() = (t: "amount")
+
+/// A whole JSON number.
+/// -> dictionary
+#let integer(min: none, max: none) = (t: "int", min: min, max: max)
+
+/// `true` or `false`.
+/// -> dictionary
+#let boolean() = (t: "bool")
+
+/// A calendar date `"YYYY-MM-DD"` (ISO 8601). TOML dates are read natively.
+/// -> dictionary
+#let date() = (t: "date")
+
+/// A date, or a period `{"start": "YYYY-MM-DD", "end": "YYYY-MM-DD"}`.
+/// -> dictionary
+#let period() = (t: "period")
+
+/// One of the given strings.
+/// -> dictionary
+#let enum(..values) = (t: "enum", values: values.pos())
+
+/// Exactly this value (used for discriminators).
+/// -> dictionary
+#let const(value) = (t: "const", value: value)
+
+/// A named object of the schema (closed: unknown keys are reported).
+/// -> dictionary
+#let ref(name) = (t: "ref", name: name)
+
+/// A list of values of one type.
+/// -> dictionary
+#let array(of, min: none) = (t: "array", of: of, min: min)
+
+/// An open object whose values all have one type (e.g. `extra` labels).
+/// -> dictionary
+#let map(of) = (t: "map", of: of)
+
+/// Any JSON value, passed through as decoded (the open `custom` bag).
+/// -> dictionary
+#let any() = (t: "any")
+
+/// One of several types, chosen by the JSON kind of the value (string,
+/// number, object, array): the alternatives must differ in kind. `conv` names
+/// the converter that builds the Typst value (decode.typ `_convert`).
+/// -> dictionary
+#let union(..of, conv: none) = (t: "union", of: of.pos(), conv: conv)
+
+/// An object chosen by a discriminator key (`kind`), with a default case.
+/// -> dictionary
+#let tagged(key, default, cases) = (
+  t: "tagged",
+  key: key,
+  default: default,
+  cases: cases,
+)
+
+/// Marks a type with the converter that turns the decoded JSON value into
+/// the Typst value of the API (a tax dictionary, a `unit.*` function, an
+/// `id.*` identifier).
+/// -> dictionary
+#let converted(type, conv) = type + (conv: conv)
+
+/// A field of an object: its type plus the contract metadata.
+/// - doc:      one sentence for the reference and the JSON Schema
+/// - bt:       the EN 16931 business term or group (`"BT-1"`, `"BG-25"`)
+/// - required: the data must give it (JSON Schema `required`)
+/// - role:     precedence when a skeleton is hydrated (`invoice()` keys and
+///             the keys of `payment`): "document" = identifies ONE invoice,
+///             from the data only (the skeleton's value is a sample; absent =
+///             the signature's own default, never a copy of it); "issuer" =
+///             the skeleton's value stays unless the data gives the key; none
+///             = not a parameter (a body section or a nested key)
+/// - bind:     where a top-level section goes instead of an invoice()
+///             parameter: "line-items" (the items slot), "payment" (the
+///             `payment(..)` block)
+/// - example:  a JSON example value
+/// - since:    the format minor version that added the field ("1.0")
+/// -> dictionary
+#let field(
+  type,
+  doc: none,
+  bt: none,
+  required: false,
+  role: none,
+  bind: none,
+  example: none,
+  since: "1.0",
+) = (
+  type: type,
+  doc: doc,
+  bt: bt,
+  required: required,
+  role: role,
+  bind: bind,
+  example: example,
+  since: since,
+)
+
+/// A named object: its fields, whether unknown keys are allowed, and the
+/// cross-field rules (`exactly-one`, `at-most-one`/`exclusive`, and
+/// `excludes-if-true`: `(a, b)` = `b` must be absent when `a` is `true`).
+/// `partial`: an object that lacks a required key is kept (parties: the legal
+/// checks name the gap); otherwise it is left out as a whole (a line without
+/// a price).
+/// -> dictionary
+#let object(
+  fields,
+  doc: none,
+  open: false,
+  partial: false,
+  exactly-one: (),
+  at-most-one: (),
+  exclusive: (),
+  excludes-if-true: (),
+) = (
+  fields: fields,
+  doc: doc,
+  open: open,
+  partial: partial,
+  exactly-one: exactly-one,
+  at-most-one: at-most-one,
+  exclusive: exclusive,
+  excludes-if-true: excludes-if-true,
+)
