+// The items slot, the implicit binding point of the data's `items`,
+// `modifiers` and `prepayments`: the body of `line-items` is a preview sample.
+// Without data it passes the children through. Hydrated (`ctx.hydration`,
+// sealed by invoice()), the rows of the data take the place of the whole
+// body (ONE motif emits their frames, contract/rows.typ), unless the body
+// has an explicit `invoice-data.items[..]` marker, which then places them
+// (static rows outside it stay). The marker leaves a frame of its own kind
+// for this slot to count and remove. The engine is imported only when used.
+#let _items-slot(body) = motif(
+  measure: (ctx, children) => {
+    let markers = children.filter(f => f.kind == "invoice-data-items").len()
+    if markers > 1 {
+      panic(
+        "`invoice-data.items[..]` is the binding point of the data's line items: a `line-items` may have at most one, found "
+          + str(markers)
+          + ".",
+      )
+    }
+    let kept = if markers == 0 { children } else {
+      children.filter(f => f.kind != "invoice-data-items")
+    }
+    let h = ctx.at("hydration", default: none)
+    if h == none or markers > 0 { return (kept, false) }
+    import "../contract/rows.typ": compute, env-of
+    (compute(h.value.rows, env-of(ctx)), true)
+  },
+  draw: (ctx, _, hydrated, body) => if not hydrated { body },
+  body,
+)
+
 /// The root container for all invoice items, bundles, and modifiers.
 /// It establishes overarching tax settings, manages the global application of modifiers,
 /// and handles the formatting of the generated invoice data.
@@ -721,6 +751,6 @@
     (
       modifier-applicator,
       tax-applicator,
-    ).fold(body, (c, f) => f(c)),
+    ).fold(_items-slot(body), (c, f) => f(c)),
   )
 }
diff --git a/src/components/payment.typ b/src/components/payment.typ
new file mode 100644
index 0000000..fa902a7
--- /dev/null
+++ b/src/components/payment.typ
@@ -0,0 +1,201 @@
+// The payment block (design B's component, one copy): one place in the
+// skeleton for everything about the payment, given in the shape of the data
+// format's `payment` section. It
+// writes the components the arguments call for (payment-terms, direct-debit,
+// card-payment or paid, bank-details), so a hydrated invoice can change WHICH
+// of them exist: the data chooses the method.
+#import "../loom-wrapper.typ": loom, loom-key, motif
+#import "../utils/types.typ"
+#import "payment-terms.typ": payment-terms
+#import "bank-details.typ": bank-details
+#import "payment-means.typ": (
+  card-payment, direct-debit as direct-debit-component, paid as paid-component,
+)
+
+#let _hydration(ctx) = {
+  let h = ctx.at("hydration", default: none)
+  if type(h) == content { h.value } else { h }
+}
+
+#let _missing(v) = v in (none, "", [])
+
+// The components of the block, and the data issues of an incomplete method.
+#let _components(a, show-reference, qr-code) = {
+  let method = if a.method != auto { a.method } else if a.paid != none {
+    "paid"
+  } else if a.direct-debit != none { "direct-debit" } else if a.card != none {
+    "card"
+  } else { "transfer" }
+  let issues = ()
+  let parts = ()
+  // a missing detail of the method: a data issue, and the component is left out
+  let missing(path) = {
+    import "../validation/issue.typ": issue
+    issue(
+      "schema/" + path.replace(".", "/"),
+      "data",
+      "invoice data: `"
+        + path
+        + "` is required: the payment method is \""
+        + method
+        + "\".",
+      ref: "invoice-pro/1 · " + path,
+      key: "schema-required",
+      args: (path: "/" + path.replace(".", "/")),
+    )
+  }
+  let p = if a.paid == none { (:) } else { a.paid }
+  if method == "paid" {
+    parts.push(paid-component(
+      method: p.at("method", default: auto),
+      date: p.at("date", default: none),
+    ))
+  } else if a.terms != none {
+    // the data's free-text terms (BT-20) are the text `date` of payment-terms
+    let t = a.terms
+    if "text" in t {
+      t.date = t.remove("text")
+    }
+    parts.push(payment-terms(..t))
+  }
+  if method == "direct-debit" {
+    let d = if a.direct-debit == none { (:) } else { a.direct-debit }
+    if _missing(d.at("mandate", default: none)) {
+      issues.push(missing("payment.direct-debit.mandate"))
+    }
+    if _missing(a.creditor-id) { issues.push(missing("payment.creditor-id")) }
+    if issues.len() == 0 {
+      parts.push(direct-debit-component(
+        mandate: d.mandate,
+        creditor-id: a.creditor-id,
+        debtor-iban: d.at("debtor-iban", default: none),
+      ))
+    }
+  } else if method == "card" {
+    let c = if a.card == none { (:) } else { a.card }
+    if _missing(c.at("last4", default: none)) {
+      issues.push(missing("payment.card.last4"))
+    } else {
+      parts.push(card-payment(
+        last4: c.last4,
+        holder: c.at("holder", default: none),
+        kind: c.at("kind", default: auto),
+      ))
+    }
+  }
+  // The account is the payment means of a transfer only: an invoice states
+  // one payment means (BT-81, CII-SR-467), so a direct debit, a card or a
+  // paid invoice leaves it out; an invoice paid BY transfer keeps it (the
+  // e-invoice needs the account then, CII-SR-470; design A).
+  let by-transfer = method == "paid" and p.at("method", default: auto) == "transfer"
+  if a.bank != none and (method == "transfer" or by-transfer) {
+    parts.push(bank-details(
+      ..a.bank,
+      show-reference: show-reference,
+      qr-code: qr-code,
+    ))
+  }
+  (parts.join(), issues)
+}
+
+/// The payment of the invoice in one block: the payment terms, the method
+/// (credit transfer, SEPA direct debit, payment card, or already paid) and the
+/// account to pay to. It places `payment-terms`, `direct-debit`,
+/// `card-payment` or `paid`, and `bank-details` as these arguments call for.
+///
+/// When the invoice is hydrated (`invoice(data: ..)`), the `payment` section
+/// of the data applies key by key: `terms`, `method`, `bank` and `creditor-id`
+/// keep this call's value unless the data gives them; `direct-debit`, `card`
+/// and `paid` describe one invoice and come from the data only (the values
+/// here are preview samples).
+///
+/// -> content
+#let payment(
+  /// The payment terms: `(days: 14)`, `(date: datetime(..))`, optionally
+  /// with `discount: (days: 7, percent: 2%)` (see `payment-terms`). `none`
+  /// prints none.
+  /// -> none | dictionary
+  terms: none,
+  /// How the recipient pays: `"transfer"`, `"direct-debit"`, `"card"` or
+  /// `"paid"`. `auto`: the method whose details are given, else a transfer.
+  /// -> auto | "transfer" | "direct-debit" | "card" | "paid"
+  method: auto,
+  /// The account to pay to: `(name: .., bank: .., iban: .., bic: ..)` (see
+  /// `bank-details`).
+  /// -> none | dictionary
+  bank: none,
+  /// The SEPA creditor identifier of the sender, for `"direct-debit"`.
+  /// -> none | str
+  creditor-id: none,
+  /// `(mandate: .., debtor-iban: ..)` of a direct debit.
+  /// -> none | dictionary
+  direct-debit: none,
+  /// `(last4: .., holder: .., kind: ..)` of a card payment.
+  /// -> none | dictionary
+  card: none,
+  /// `(method: .., date: ..)` of an invoice that is already paid.
+  /// -> none | dictionary
+  paid: none,
+  /// Layout: whether the bank details print the payment reference.
+  /// -> bool
+  show-reference: true,
+  /// Layout: the EPC QR code of the bank details, see `bank-details`.
+  /// -> dictionary
+  qr-code: (:),
+) = {
+  types.require(terms, "payment::terms", none, dictionary)
+  types.require(
+    method,
+    "payment::method",
+    auto,
+    "transfer",
+    "direct-debit",
+    "card",
+    "paid",
+  )
+  types.require(bank, "payment::bank", none, dictionary)
+  types.require(creditor-id, "payment::creditor-id", none, str, content)
+  types.require(direct-debit, "payment::direct-debit", none, dictionary)
+  types.require(card, "payment::card", none, dictionary)
+  types.require(paid, "payment::paid", none, dictionary)
+  types.require(show-reference, "payment::show-reference", bool)
+
+  let own = (
+    terms: terms,
+    method: method,
+    bank: bank,
+    creditor-id: creditor-id,
+    direct-debit: direct-debit,
+    card: card,
+    paid: paid,
+  )
+  let effective(ctx) = {
+    let h = _hydration(ctx)
+    if h == none { return own }
+    import "../contract/hydrate.typ": payment-args
+    payment-args(own, h.payment)
+  }
+  // The components exist only once the data is known (in the weave), so the
+  // block weaves them itself, like the content cells of a theme
+  // (loom-wrapper.typ `eval-content`).
+  motif(
+    measure: (ctx, _) => {
+      let (parts, issues) = _components(effective(ctx), show-reference, qr-code)
+      let (_, frames) = loom.core.intertwine(
+        ctx,
+        parts,
+        key: loom-key,
+        draw: false,
+      )
+      (
+        frames + (loom.frame.new(kind: "payment", signal: (issues: issues)),),
+        none,
+      )
+    },
+    draw: (ctx, ..) => {
+      let (parts, _) = _components(effective(ctx), show-reference, qr-code)
+      loom.core.intertwine(ctx, parts, key: loom-key, draw: true).first()
+    },
+    none,
+  )
+}
