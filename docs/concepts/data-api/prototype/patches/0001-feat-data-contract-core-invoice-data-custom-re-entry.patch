+        ),
+        doc: "Format and version of the data: \"invoice-pro/1\" (optionally with the minor version the data needs, \"invoice-pro/1.0\").",
+        required: true,
+        example: "invoice-pro/1",
+      ),
+      invoice-nr: field(
+        t.text(),
+        doc: "Invoice number.",
+        bt: "BT-1",
+        required: true,
+        role: "document",
+        example: "2026-0042",
+      ),
+      date: field(
+        t.date(),
+        doc: "Issue date.",
+        bt: "BT-2",
+        required: true,
+        role: "document",
