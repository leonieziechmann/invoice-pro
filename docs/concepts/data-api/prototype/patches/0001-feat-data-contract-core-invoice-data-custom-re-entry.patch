diff --git a/src/contract/decode.typ b/src/contract/decode.typ
new file mode 100644
index 0000000..96c4030
--- /dev/null
+++ b/src/contract/decode.typ
@@ -0,0 +1,951 @@
+// The decoder: interprets the descriptor (schema.typ) over parsed data.
+//
+// Pure data in, Typst values out: no eval, no file access, no panic for a
+// problem in the data. Every problem becomes ONE `data` issue whose id is
+// "schema" + the JSON Pointer of the value ("schema/items/3/price"), so the
+// validation level decides what happens (draft: report + XML withheld,
+// strict: stop, none: silent). The invalid value is left out, so a required
+// key the data got wrong is also reported by the legal checks (check-data).
+//
+// What the decoder accepts is the JSON Schema of export.typ plus three
+// documented leniencies: JSON null = absent (also as `kind`), JSON numbers
+// for decimals (converted exactly), and native TOML dates. The conformance
+// fixtures check that every document the JSON Schema accepts decodes without
+// issues, and the reverse.
+//
+// Crash-free (Typst has no try/catch): every value is pattern-checked before
+// `decimal()`, `datetime()` or a constructor sees it, every type is checked
+// before a method call, `in` never sees `none`, and the rules the loom guards
+// would check for a hand-written body (nesting, the VAT scope of a modifier,
+// note/origin in a bundle, amounts in range) are checked here, because data
+// rows do not pass through those guards.
+#import "schema.typ" as s
+#import "../validation/issue.typ": issue
+#import "../utils/patch.typ": did-you-mean
+#import "../data/tax.typ" as m-tax
+#import "../public/id.typ" as m-id
+#import "../public/unit.typ" as m-unit
+
+// "no value": absent, null, or invalid (then an issue says why)
+#let _drop = auto
+
+// ---- paths --------------------------------------------------------------------
+
+#let _escape(k) = str(k).replace("~", "~0").replace("/", "~1")
+/// JSON Pointer (RFC 6901) of a path given as an array of keys/indices.
+#let pointer(path) = path.map(k => "/" + _escape(k)).join()
+#let _ptr(path) = if path.len() == 0 { "" } else { pointer(path) }
+// what a person reads: items[3].price
+#let dotted(path) = {
+  let out = ""
+  for k in path {
+    if type(k) == int { out += "[" + str(k) + "]" } else if out == "" {
+      out += k
+    } else { out += "." + k }
+  }
+  if out == "" { "(document)" } else { out }
+}
+
+// the subject of a message: "invoice data" or "invoice data: `items[3]`"
+#let _where(path) = if path.len() == 0 { "invoice data" } else {
+  "invoice data: `" + dotted(path) + "`"
+}
+
+#let _kind(v) = {
+  let t = type(v)
+  if v == none { "null" } else if t == str { "string" } else if t == int {
+    "integer"
+  } else if t == float { "number" } else if t == bool { "boolean" } else if (
+    t == dictionary
+  ) { "object" } else if t == array { "array" } else if t == datetime {
+    "date"
+  } else if t == decimal { "decimal" } else if t == ratio { "ratio" } else {
+    str(t)
+  }
+}
+#let _shown(v) = {
+  let r = if type(v) == str { "\"" + v + "\"" } else { repr(v) }
+  if r.len() > 40 { r.slice(0, 37) + "…" } else { r }
+}
+
+/// The issue of a problem at `path`. `key` names the kind of problem; the
+/// locale string `strings.validation.issues.schema-<key>` may translate it.
+#let problem(path, key, message, fix: none, args: (:)) = issue(
+  "schema" + _ptr(path),
+  "data",
+  message,
+  ref: s.format + " · " + dotted(path),
+  fix: fix,
+  key: "schema-" + key,
+  args: (path: _ptr(path)) + args,
+)
+#let _bad(path, expected, v, fix: none) = (
+  _drop,
+  (
+    problem(
+      path,
+      "type",
+      "invoice data: `"
+        + dotted(path)
+        + "` must be "
+        + expected
+        + ", found "
+        + _shown(v)
+        + ".",
+      fix: fix,
+      args: (expected: expected, found: _kind(v)),
+    ),
+  ),
+)
+
+// ---- scalar parsers (value only, so Typst memoizes repeated values) ----------
+
+// ASCII classes: `\d` matches every Unicode digit (and is slower in Typst).
+#let _date-re = regex("^([0-9]{4})-([0-9]{2})-([0-9]{2})$")
+#let _dec-re = regex("^-?[0-9]{1,20}(\.[0-9]{1,10})?$")
+#let _pct-re = regex("^([0-9]{1,3}(?:\.[0-9]{1,6})?)%$")
+
+#let _days-in(y, m) = if m == 2 {
+  if calc.rem(y, 4) == 0 and (calc.rem(y, 100) != 0 or calc.rem(y, 400) == 0) {
+    29
+  } else { 28 }
+} else if m in (4, 6, 9, 11) { 30 } else { 31 }
+
+#let _date-of(x) = {
+  let m = x.match(_date-re)
+  if m == none { return none }
+  let (y, mo, d) = m.captures.map(int)
+  if mo >= 1 and mo <= 12 and d >= 1 and d <= _days-in(y, mo) {
+    datetime(year: y, month: mo, day: d)
+  }
+}
+// a decimal Typst can hold: at most 28 significant digits (the pattern alone
+// admits 30, which `decimal()` rejects with a hard error)
+#let _decimal-of(x) = {
+  let m = x.match(_dec-re)
+  if m == none { return none }
+  let parts = x.trim("-", at: start).split(".")
+  let (int-part, frac) = (parts.first(), parts.at(1, default: ""))
+  if int-part.trim("0", at: start).len() + frac.len() > 28 { return none }
+  decimal(x)
+}
+// float(n) / 100 * 100% equals the Typst literal bit for bit (n * 1% does
+// not, e.g. for 9.975%); the regions' tax inference compares with ==.
+#let _percent-of(x) = {
+  let m = x.match(_pct-re)
+  if m != none { float(m.captures.first()) / 100 * 100% }
+}
+
+// ---- converters: decoded JSON -> the Typst value of the API -------------------
+
+#let _unit-names = dictionary(m-unit)
+#let _unit-fn(name) = _unit-names.at(if name == "set" { "unit-set" } else {
+  name
+})
+
+// The labels of the `tax.*` constructors by UNTDID 5305 category (a tax
+// object of the data equals the constructor's dictionary).
+#let _tax-labels = (
+  S: "vat",
+  Z: "zero",
+  E: "exempt",
+  AE: "reverse-charge",
+  K: "intra-community",
+  G: "export",
+  O: "outside-scope",
+  A: "mixed",
+  AA: "lower-rate",
+  AB: "exempt-for-resale",
+  AC: "vat-not-due",
+  AD: "vat-previous",
+  B: "transferred",
+  C: "duty-paid",
+  D: "margin-travel",
+  F: "margin-second-hand",
+  H: "higher-rate",
+  I: "margin-art",
+  J: "margin-antiques",
+  L: "canary-islands",
+  M: "ceuta-melilla",
+  N: "standard-additional",
+)
+
+#let _convert(conv, v, path) = {
+  if conv == "tax" {
+    if type(v) == ratio {
+      if v == 0% {
+        return (
+          _drop,
+          (
+            problem(
+              path,
+              "tax-zero",
+              "invoice data: `"
+                + dotted(path)
+                + "` is \"0%\": a rate of zero needs its category, e.g. {\"category\": \"E\", \"grounds\": \"…\"} (exempt), \"AE\" (reverse charge), \"K\" (intra-community), \"G\" (export), \"O\" (outside scope) or \"Z\" (zero rated).",
+              fix: "{\"category\": \"E\", \"grounds\": \"§ 4 Nr. 14 UStG\"}",
+            ),
+          ),
+        )
+      }
+      // "19%" stays the ratio: the region's `infer-tax` resolves it exactly
+      // as `tax: 19%` written in Typst (the region pass checks the rate)
+      return (v, ())
+    }
+    let c = v.category
+    let rate = v.at("rate", default: 0%)
+    if c == "S" and rate == 0% {
+      return (
+        _drop,
+        (
+          problem(
+            path + ("rate",),
+            "tax-rate",
+            "invoice data: `"
+              + dotted(path)
+              + "` has category \"S\" (standard rate) but no rate: give \"rate\": \"19%\", or the category of a zero rate.",
+            fix: "\"rate\": \"19%\"",
+          ),
+        ),
+      )
+    }
+    return (
+      m-tax.new(
+        rate: rate,
+        category: c,
+        label: v.at("label", default: _tax-labels.at(c)),
+        grounds: v.at("grounds", default: if c == "AE" {
+          "Reverse charge"
+        }),
+        code: v.at("code", default: none),
+      ),
+      (),
+    )
+  }
+  if conv == "unit" {
+    if type(v) == str {
+      let name = s.unit-codes.at(v, default: none)
+      // another Rec 20 code prints as the code (the alias table of the
+      // e-invoice knows it as such)
+      if name == none { return ((code: v, display: v), ()) }
+      return (_unit-fn(name), ())
+    }
+    return (v, ())
+  }
+  if conv == "identifier" {
+    if type(v) != dictionary { return (v, ()) }
+    let sc = v.scheme
+    let made = if sc == "gln" { m-id.gln(v.id) } else if sc == "duns" {
+      m-id.duns(v.id)
+    } else if sc == "siren" { m-id.siren(v.id) } else if sc == "siret" {
+      m-id.siret(v.id)
+    } else if sc == "uid-ch" { m-id.uid-ch(v.id) } else if sc == "leitweg" {
+      m-id.leitweg(v.id)
+    } else if sc == "register" {
+      m-id.register(v.id, court: v.at("court", default: none))
+    } else { (scheme: sc, id: v.id) }
+    return (made, ())
+  }
+  if conv == "leitweg" { return (m-id.leitweg(v), ()) }
+  (v, ())
+}
+
+// ---- rules of the line items (the loom guards of hand-written rows) ------------
+
+// containers nest at most this deep: `collect-signals(depth: 10)` in
+// calculate-modifier would leave deeper items out of the totals silently
+#let max-nesting = 8
+#let _row-rules = ("item", "group", "bundle")
+#let _level(path) = path.filter(k => k == "items").len()
+
+// whether rows hold at least one item (a modifier without a pinned tax takes
+// its VAT category from them)
+#let has-item(rows) = rows.any(r => {
+  let k = r.at("kind", default: "item")
+  if k == "item" { true } else { has-item(r.at("items", default: ())) }
+})
+
+// amounts Typst's decimals can compute with (price × quantity ÷ base)
+#let _in-range(row) = {
+  let q = calc.abs(float(row.at("quantity", default: decimal("1"))))
+  let b = float(row.at("base-quantity", default: decimal("1")))
+  let a = calc.abs(float(row.at("price", default: row.at(
+    "total",
+    default: decimal("0"),
+  ))))
+  a * calc.max(q, 1.0) / calc.min(b, 1.0) < 1e18
+}
+
+// (row or false, issues) of a decoded row at `path`
+#let _rule-row(name, row, path) = {
+  let issues = ()
+  if name in ("group", "bundle") and _level(path) > max-nesting {
+    return (
+      false,
+      (
+        problem(
+          path,
+          "nesting",
+          _where(path)
+            + " nests groups and bundles deeper than "
+            + str(max-nesting)
+            + " levels; flatten it.",
+        ),
+      ),
+    )
+  }
+  if name == "item" and not _in-range(row) {
+    return (
+      false,
+      (
+        problem(
+          path,
+          "range",
+          _where(path)
+            + " has an amount out of range (price × quantity must stay below 10^18).",
+        ),
+      ),
+    )
+  }
+  if name == "bundle" {
+    let kids = row.at("items", default: ())
+    let fixed = ()
+    for (i, kid) in kids.enumerate() {
+      if kid.kind == "item" and ("note" in kid or "origin" in kid) {
+        issues.push(problem(
+          path + ("items", i),
+          "placement",
+          "invoice data: `"
+            + dotted(path + ("items", i))
+            + "` is an item of a bundle, which prints as one line: `note` and `origin` are left out.",
+        ))
+        let _ = kid.remove("note", default: none)
+        let _ = kid.remove("origin", default: none)
+      }
+      fixed.push(kid)
+    }
+    row.items = fixed
+    if not has-item(fixed) {
+      return (
+        false,
+        issues
+          + (
+            problem(
+              path + ("items",),
+              "required",
+              _where(path) + " has no valid item.",
+            ),
+          ),
+      )
+    }
+  }
+  (row, issues)
+}
+
+// Document modifiers without a pinned `tax` take their VAT category from the
+// items; without any item they would stop the compilation.
+#let _scope-issues(values) = {
+  let mods = values.at("modifiers", default: ())
+  if mods.len() == 0 or has-item(values.at("items", default: ())) {
+    return (values, ())
+  }
+  let issues = ()
+  let kept = ()
+  for (i, m) in mods.enumerate() {
+    if "tax" in m { kept.push(m) } else {
+      issues.push(problem(
+        ("modifiers", i),
+        "placement",
+        "invoice data: `modifiers["
+          + str(i)
+          + "]` takes its VAT category from the items, but the data has no valid item: give it a `tax`, or add items.",
+        fix: "\"tax\": \"19%\"",
+      ))
+    }
+  }
+  values.modifiers = kept
+  (values, issues)
+}
+
+// ---- the region pass: "19%" must be a VAT rate of the locale's region ------------
+
+#let _rate-issue(path, r, region, rates) = problem(
+  path,
+  "tax-rate",
+  "invoice data: `"
+    + dotted(path)
+    + "`: "
+    + repr(r)
+    + " is no VAT rate of region "
+    + region
+    + " ("
+    + rates.map(repr).join(", ")
+    + "); for another rate write {\"category\": \"S\", \"rate\": \""
+    + repr(r)
+    + "\"}.",
+  fix: "{\"category\": \"S\", \"rate\": \"" + repr(r) + "\"}",
+)
+
+// A value whose `tax` is a rate the region does not know: the tax is left out
+// (an issue says why), so the region's `infer-tax` never panics on data.
+#let _region-of(x, path, region, rates) = {
+  let issues = ()
+  if type(x) == dictionary {
+    let t = x.at("tax", default: none)
+    if type(t) == ratio and t not in rates {
+      issues.push(_rate-issue(path + ("tax",), t, region, rates))
+      let _ = x.remove("tax")
+    }
+    for key in ("items", "modifiers") {
+      let kids = x.at(key, default: none)
+      if type(kids) != array { continue }
+      let out = ()
+      for (i, kid) in kids.enumerate() {
+        let (y, iss) = _region-of(kid, path + (key, i), region, rates)
+        out.push(y)
+        issues += iss
+      }
+      x.insert(key, out)
+    }
+  }
+  (x, issues)
+}
+
+/// The region pass over decoded values: `rates` are the region's VAT rates
+/// (`locale.normalize.vat-rates`); `none` skips it (a region that does not
+/// list them: its `infer-tax` decides, as for `tax: 16%` written in Typst).
+/// -> array
+#let region-pass(values, region, rates) = {
+  if rates == none or type(values) != dictionary { return (values, ()) }
+  _region-of(values, (), region, rates)
+}
+
+// ---- the interpreter ------------------------------------------------------------
+
+#let _finish(ty, value, issues, path) = {
+  if value != _drop and ty.at("conv", default: none) != none {
+    let (value, more) = _convert(ty.conv, value, path)
+    (value, issues + more)
+  } else { (value, issues) }
+}
+
+// The JSON kinds a type accepts (for unions and messages).
+#let _kinds(ty, objs) = {
+  let t = ty.t
+  if t in ("text", "enum") { ("string",) } else if t == "lines" {
+    ("string", "array")
+  } else if t == "decimal" {
+    ("string", "integer", "number", "decimal")
+  } else if (
+    t in ("percent", "amount")
+  ) { ("string", "ratio", "decimal") } else if t == "int" {
+    ("integer",)
+  } else if (
+    t == "bool"
+  ) { ("boolean",) } else if t == "date" { ("string", "date") } else if (
+    t == "period"
+  ) { ("string", "date", "object") } else if t in ("ref", "map", "tagged") {
+    ("object",)
+  } else if t == "array" { ("array",) } else if t == "const" {
+    (_kind(ty.value),)
+  } else if t == "union" { ty.of.map(x => _kinds(x, objs)).flatten() } else {
+    ("string", "integer", "number", "boolean", "object", "array", "date")
+  }
+}
+
+#let _expected(ty) = {
+  let t = ty.t
+  if t == "text" {
+    if ty.pattern-doc != none { ty.pattern-doc } else { "a string" }
+  } else if t == "lines" { "a string or an array of strings" } else if (
+    t == "decimal"
+  ) { "a decimal number written as a string such as \"12.30\"" } else if (
+    t == "percent"
+  ) { "a percentage such as \"19%\"" } else if t == "amount" {
+    "an amount such as \"50.00\" or \"10%\""
+  } else if t == "int" { "a whole number" } else if t == "bool" {
+    "true or false"
+  } else if t == "date" { "a date \"YYYY-MM-DD\"" } else if t == "period" {
+    "a date \"YYYY-MM-DD\" or {\"start\": .., \"end\": ..}"
+  } else if t == "enum" {
+    "one of " + ty.values.map(x => "\"" + x + "\"").join(", ")
+  } else if t == "const" { _shown(ty.value) } else if t in ("ref", "map") {
+    "an object"
+  } else if t == "tagged" { "an object" } else if t == "array" {
+    "an array"
+  } else if t == "union" { ty.of.map(_expected).join(", or ") } else {
+    "a value"
+  }
+}
+
+#let decode-value(ty, v, path, objs, ctx) = {
+  let t = ty.t
+  if t == "ref" {
+    // a named object: closed unless declared open, plus its cross-field rules
+    let name = ty.name
+
+    if type(v) != dictionary { return _bad(path, "an object", v) }
+    let obj = objs.value.at(ty.name)
+    let fields = obj.fields
+    let out = (:)
+    let issues = ()
+    let seen = ()
+    for (key, x) in v {
+      if key not in fields {
+        // a bag keeps what it is given, JSON null as `none`
+        if obj.open { out.insert(key, x) } else if x != none {
+          // party keys: the alias table of the e-invoice (plz, mail, ust-id, …)
+          let hint = if (
+            name
+              in ("seller", "buyer", "ship-to", "payee", "tax-representative")
+          ) {
+            import "../zugferd/keys.typ": unknown-key
+            let u = unknown-key(
+              key,
+              fields.keys().map(x => (x, true)).to-dict(),
+            )
+            (
+              if u.like != none { " Did you mean `" + u.like + "`?" } else {
+                ""
+              }
+                + if u.hint != none { " " + u.hint } else { "" }
+            )
+          } else { did-you-mean(key, fields.keys()) }
+          let newer = if ctx.minor > s.minor {
+            (
+              " The data is written for "
+                + s.format
+                + "."
+                + str(ctx.minor)
+                + "; this invoice-pro reads "
+                + s.format
+                + "."
+                + str(s.minor)
+                + ": update invoice-pro, or leave the key out."
+            )
+          } else { "" }
+          issues.push(problem(
+            path + (key,),
+            "unknown-key",
+            _where(path)
+              + " has an unknown key `"
+              + key
+              + "`."
+              + hint
+              + newer
+              + " Allowed keys: "
+              + fields.keys().filter(x => x != "$schema").join(", ")
+              + ". Your own fields belong in `custom`.",
+            args: (key: key),
+          ))
+        }
+        continue
+      }
+      // null = absent, at every level
+      if x == none { continue }
+      let f = fields.at(key)
+      if x == "" and f.type.t in ("text", "lines") {
+        if f.required {
+          issues.push(problem(
+            path + (key,),
+            "required",
+            "invoice data: `" + dotted(path + (key,)) + "` must not be empty.",
+          ))
+          seen.push(key)
+        }
+        continue
+      }
+      seen.push(key)
+      let (y, iss) = decode-value(f.type, x, path + (key,), objs, ctx)
+      issues += iss
+      if y != _drop { out.insert(key, y) }
+    }
+    // keys the data gave whose value was invalid (an issue said why)
+    let invalid = seen.filter(x => x not in out)
+    let broken = false
+    for (key, f) in fields {
+      if not f.required { continue }
+      if key in invalid { broken = true }
+      if key not in seen {
+        broken = true
+        issues.push(problem(
+          path + (key,),
+          "required",
+          _where(path)
+            + " needs `"
+            + key
+            + "`"
+            + if f.doc != none { " (" + f.doc.trim(".", at: end) + ")" } else {
+              ""
+            }
+            + ".",
+          fix: if f.example != none {
+            "\"" + key + "\": " + json.encode(f.example)
+          },
+          args: (key: key),
+        ))
+      }
+    }
+    for group in obj.exactly-one {
+      let given = group.filter(x => x in seen)
+      if given.len() != 1 {
+        broken = true
+        issues.push(problem(
+          path,
+          "exactly-one",
+          _where(path)
+            + " needs exactly one of "
+            + group.map(x => "`" + x + "`").join(" or ")
+            + ", found "
+            + if given.len() == 0 { "none" } else { given.join(" and ") }
+            + ".",
+        ))
+      } else if given.first() in invalid { broken = true }
+    }
+    for group in obj.at-most-one + obj.exclusive {
+      let given = group.filter(x => x in seen)
+      if given.len() > 1 {
+        issues.push(problem(
+          path,
+          "exclusive",
+          _where(path)
+            + " cannot have both "
+            + given.map(x => "`" + x + "`").join(" and ")
+            + ".",
+        ))
+        for x in given.slice(1) { let _ = out.remove(x, default: none) }
+      }
+    }
+    for (a, b) in obj.excludes-if-true {
+      if out.at(a, default: false) == true and b in out {
+        issues.push(problem(
+          path + (b,),
+          "exclusive",
+          _where(path)
+            + " cannot have `"
+            + b
+            + "` together with `"
+            + a
+            + "`: true.",
+        ))
+        let _ = out.remove(b)
+      }
+    }
+    // An object that lacks what it needs is left out as a whole (a line
+    // without a price cannot be computed), unless the schema keeps a partial
+    // one (parties: the legal checks then name what is missing).
+    if broken and not obj.partial { return (_drop, issues) }
+    if name in _row-rules {
+      let (row, more) = _rule-row(name, out, path)
+      issues += more
+      if row == false { return (_drop, issues) }
+      out = row
+    }
+    return _finish(ty, out, issues, path)
+  }
+  let k = _kind(v)
+  let result = if t == "any" { (v, ()) } else if t == "text" {
+    if k != "string" {
+      _bad(path, _expected(ty), v, fix: if k in ("integer", "number") {
+        "\"" + str(v) + "\""
+      })
+    } else if ty.max != none and v.len() > ty.max {
+      (
+        _drop,
+        (
+          problem(
+            path,
+            "length",
+            "invoice data: `"
+              + dotted(path)
+              + "` has "
+              + str(v.len())
+              + " characters; at most "
+              + str(ty.max)
+              + " are allowed.",
+          ),
+        ),
+      )
+    } else if ty.pattern != none and v.match(regex(ty.pattern)) == none {
+      _bad(path, _expected(ty), v, fix: ty.at("example", default: none))
+    } else { (v, ()) }
+  } else if t == "lines" {
+    if k == "string" { (v, ()) } else if (
+      k == "array" and v.all(x => type(x) == str)
+    ) { (v, ()) } else { _bad(path, _expected(ty), v) }
+  } else if t == "decimal" {
+    let d = if k == "string" { _decimal-of(v) } else if k == "integer" {
+      decimal(v)
+    } else if k == "number" { _decimal-of(str(v)) } else if k == "decimal" {
+      v
+    }
+    if d == none {
+      _bad(path, _expected(ty), v, fix: "\"12.30\"")
+    } else if ty.positive and d <= 0 {
+      _bad(path, "a decimal greater than 0", v)
+    } else if ty.min != none and d < ty.min {
+      _bad(path, "a decimal of at least " + str(ty.min), v)
+    } else { (d, ()) }
+  } else if t == "percent" {
+    let r = if k == "string" { _percent-of(v) } else if k == "ratio" { v }
+    if r == none {
+      _bad(path, _expected(ty), v, fix: "\"19%\"")
+    } else if ty.min != none and r < ty.min {
+      _bad(path, "a percentage of at least " + repr(ty.min), v)
+    } else if ty.max != none and r > ty.max {
+      _bad(path, "a percentage of at most " + repr(ty.max), v)
+    } else { (r, ()) }
+  } else if t == "amount" {
+    if (k == "string" and v.ends-with("%")) or k == "ratio" {
+      decode-value((t: "percent", min: 0%, max: none), v, path, objs, ctx)
+    } else {
+      decode-value(
+        (t: "decimal", min: decimal("0"), positive: false),
+        v,
+        path,
+        objs,
+        ctx,
+      )
+    }
+  } else if t == "int" {
+    if k != "integer" { _bad(path, _expected(ty), v) } else if (
+      ty.min != none and v < ty.min
+    ) { _bad(path, "a whole number of at least " + str(ty.min), v) } else if (
+      ty.max != none and v > ty.max
+    ) { _bad(path, "a whole number of at most " + str(ty.max), v) } else {
+      (v, ())
+    }
+  } else if t == "bool" {
+    if k == "boolean" { (v, ()) } else { _bad(path, _expected(ty), v) }
+  } else if t == "date" {
+    let d = if k == "string" { _date-of(v) } else if (
+      k == "date" and v.day() != none
+    ) { v }
+    if d == none { _bad(path, _expected(ty), v, fix: "\"2026-11-02\"") } else {
+      (d, ())
+    }
+  } else if t == "period" {
+    if k == "object" {
+      let unknown = v.keys().filter(x => x not in ("start", "end"))
+      if unknown.len() > 0 or "start" not in v or "end" not in v {
+        _bad(
+          path,
+          _expected(ty),
+          v,
+          fix: "{\"start\": \"2026-10-01\", \"end\": \"2026-10-31\"}",
+        )
+      } else {
+        let (a, ia) = decode-value(
+          (t: "date"),
+          v.start,
+          path + ("start",),
+          objs,
+          ctx,
+        )
+        let (b, ib) = decode-value(
+          (t: "date"),
+          v.end,
+          path + ("end",),
+          objs,
+          ctx,
+        )
+        if ia.len() + ib.len() > 0 { (_drop, ia + ib) } else if b < a {
+          (
+            _drop,
+            (
+              problem(
+                path,
+                "period",
+                "invoice data: `" + dotted(path) + "` ends before it starts.",
+              ),
+            ),
+          )
+        } else { ((a, b), ()) }
+      }
+    } else { decode-value((t: "date"), v, path, objs, ctx) }
+  } else if t == "enum" {
+    if k == "string" and v in ty.values { (v, ()) } else {
+      let hint = if k == "string" { did-you-mean(v, ty.values) } else { "" }
+      (
+        _drop,
+        (
+          problem(
+            path,
+            "enum",
+            "invoice data: `"
+              + dotted(path)
+              + "` must be "
+              + _expected(ty)
+              + ", found "
+              + _shown(v)
+              + "."
+              + hint,
+            args: (allowed: ty.values.join(", ")),
+          ),
+        ),
+      )
+    }
+  } else if t == "const" {
+    if v == ty.value { (v, ()) } else { _bad(path, _expected(ty), v) }
+  } else if t == "array" {
+    if k != "array" { _bad(path, _expected(ty), v) } else if (
+      ty.min != none and v.len() < ty.min
+    ) {
+      (
+        _drop,
+        (
+          problem(
+            path,
+            "length",
+            "invoice data: `"
+              + dotted(path)
+              + "` needs at least "
+              + str(ty.min)
+              + " entries.",
+          ),
+        ),
+      )
+    } else {
+      let out = ()
+      let issues = ()
+      for (i, x) in v.enumerate() {
+        if x == none {
+          issues.push(problem(
+            path + (i,),
+            "type",
+            "invoice data: `"
+              + dotted(path + (i,))
+              + "` is null; leave the entry out of the array.",
+          ))
+          continue
+        }
+        let (y, iss) = decode-value(ty.of, x, path + (i,), objs, ctx)
+        issues += iss
+        if y != _drop { out.push(y) }
+      }
+      (out, issues)
+    }
+  } else if t == "map" {
+    if k != "object" { _bad(path, _expected(ty), v) } else {
+      let out = (:)
+      let issues = ()
+      for (key, x) in v {
+        if x == none { continue }
+        let (y, iss) = decode-value(ty.of, x, path + (key,), objs, ctx)
+        issues += iss
+        if y != _drop { out.insert(key, y) }
+      }
+      (out, issues)
+    }
+  } else if t == "tagged" {
+    if k != "object" { _bad(path, "an object", v) } else {
+      // absent and null select the default case (generated models dump null)
+      let tag = v.at(ty.key, default: none)
+      if tag == none { tag = ty.default }
+      if type(tag) != str or tag not in ty.cases {
+        (
+          _drop,
+          (
+            problem(
+              path + (ty.key,),
+              "enum",
+              "invoice data: `"
+                + dotted(path + (ty.key,))
+                + "` must be one of "
+                + ty.cases.keys().map(x => "\"" + x + "\"").join(", ")
+                + ", found "
+                + _shown(tag)
+                + "."
+                + if type(tag) == str {
+                  did-you-mean(tag, ty.cases.keys())
+                } else { "" },
+            ),
+          ),
+        )
+      } else {
+        let (row, issues) = decode-value(
+          (t: "ref", name: ty.cases.at(tag)),
+          v,
+          path,
+          objs,
+          ctx,
+        )
+        // the engine reads the kind of every row
+        if row != _drop { row.insert(ty.key, tag) }
+        (row, issues)
+      }
+    }
+  } else if t == "union" {
+    let alt = ty.of.find(x => k in _kinds(x, objs))
+    if alt == none { _bad(path, _expected(ty), v) } else {
+      decode-value(alt, v, path, objs, ctx)
+    }
+  } else { panic("internal: unknown contract type " + repr(t)) }
+  // converters build the Typst value of the API from the decoded one
+  let (value, issues) = result
+  _finish(ty, value, issues, path)
+}
+
+// ---- documents ----------------------------------------------------------------------
+
+#let _format-re = regex("^invoice-pro/([0-9]+)(?:\.([0-9]+))?$")
+
+/// Decodes one document. Returns (values, issues, major, minor, fatal):
+/// `fatal` is a message when the data is in a format this package cannot
+/// read at all (another major version). `region` (e.g. `"de"`) adds the
+/// region pass with `rates`, the region's VAT rates.
+/// -> dictionary
+#let decode-document(raw, region: none, rates: none) = {
+  if type(raw) != dictionary {
+    return (
+      values: (:),
+      issues: (
+        problem(
+          (),
+          "type",
+          "invoice data must be a JSON object, found " + _kind(raw) + ".",
+        ),
+      ),
+      major: none,
+      minor: 0,
+      fatal: none,
+    )
+  }
+  let f = raw.at("format", default: none)
+  let m = if type(f) == str { f.match(_format-re) }
+  let major = if m != none { int(m.captures.at(0)) }
+  let minor = if m != none and m.captures.at(1) != none {
+    int(m.captures.at(1))
+  } else { 0 }
+  let fatal = if major != none and major != s.major {
+    (
+      "invoice data is in format \""
+        + f
+        + "\"; this invoice-pro reads "
+        + s.format
+        + " only. Convert the data, or use an invoice-pro that reads "
+        + s.family
+        + "/"
+        + str(major)
+        + "."
+    )
+  }
+  // The descriptor travels sealed: every call of the recursive decoder is
+  // memoized by Typst, which hashes its arguments, and the descriptor is
+  // large (a sealed value hashes in constant time).
+  let (values, issues) = decode-value(
+    (t: "ref", name: "invoice"),
+    raw,
+    (),
+    metadata(s.objects),
+    (minor: minor),
+  )
+  let (values, more) = _scope-issues(values)
+  issues += more
+  if region != none {
+    let (v, ri) = region-pass(values, region, rates)
+    values = v
+    issues += ri
+  }
+  (values: values, issues: issues, major: major, minor: minor, fatal: fatal)
+}
diff --git a/src/contract/export.typ b/src/contract/export.typ
new file mode 100644
index 0000000..f7303e4
--- /dev/null
+++ b/src/contract/export.typ
@@ -0,0 +1,211 @@
+// Writes a descriptor (schema.typ for the data, result-schema.typ for the
+// result) as a JSON Schema 2020-12 document. Nothing here is hand-maintained
+// per field: the JSON Schema and the decoder read the same table.
+//
+// Codegen-friendly by construction (checked with datamodel-codegen,
+// json-schema-to-typescript and typify in the prior-art research): closed
+// objects (`additionalProperties: false`) except the named `custom` bags,
+// `$defs` + `$ref`, string patterns for decimals and dates, `const`
+// discriminators, and optional properties that also accept `null` (what
+// generated models write for an unset field; the decoder reads null as
+// absent). Contract metadata travels as annotations the validators and
+// generators ignore: `x-en16931` (business term), `x-invoice-pro-role`,
+// `x-invoice-pro-bind`, `x-invoice-pro-since`.
+
+#let _dec = "-?[0-9]{1,20}(\\.[0-9]{1,10})?"
+#let _udec = "[0-9]{1,20}(\\.[0-9]{1,10})?"
+#let scalar-defs = (
+  decimal: (
+    type: "string",
+    pattern: "^" + _dec + "$",
+    description: "An exact decimal number as a string (JSON numbers are binary floats).",
+    examples: ("12.30", "-5", "0.5"),
+  ),
+  decimal-positive: (
+    allOf: (
+      ("$ref": "#/$defs/decimal-unsigned"),
+      ("not": (pattern: "^0+(\\.0+)?$")),
+    ),
+    description: "A decimal number greater than 0, as a string.",
+    examples: ("1", "0.5"),
+  ),
+  decimal-unsigned: (
+    type: "string",
+    pattern: "^" + _udec + "$",
+    description: "A decimal number of at least 0, as a string.",
+  ),
+  percent: (
+    type: "string",
+    pattern: "^[0-9]{1,3}(\\.[0-9]{1,6})?%$",
+    description: "A percentage such as \"19%\".",
+    examples: ("19%", "7%", "2.5%"),
+  ),
+  percent-unsigned: (
+    type: "string",
+    pattern: "^[0-9]{1,3}(\\.[0-9]{1,6})?%$",
+    description: "A percentage of at least 0% such as \"19%\".",
+  ),
+  percent-0-100: (
+    type: "string",
+    pattern: "^(100(\\.0{1,6})?|[0-9]{1,2}(\\.[0-9]{1,6})?)%$",
+    description: "A percentage from 0% to 100%.",
+  ),
+  amount: (
+    type: "string",
+    pattern: "^(" + _udec + "|[0-9]{1,3}(\\.[0-9]{1,6})?%)$",
+    description: "An absolute amount \"50.00\" or a relative one \"10%\" (never negative).",
+    examples: ("50.00", "10%"),
+  ),
+  date: (
+    type: "string",
+    format: "date",
+    pattern: "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
+    description: "A calendar date (ISO 8601).",
+    examples: ("2026-11-02",),
+  ),
+  period: (
+    anyOf: (
+      ("$ref": "#/$defs/date"),
+      (
+        type: "object",
+        properties: (
+          start: ("$ref": "#/$defs/date"),
+          end: ("$ref": "#/$defs/date"),
+        ),
+        required: ("start", "end"),
+        additionalProperties: false,
+      ),
+    ),
+    description: "A date, or a period from start to end (inclusive).",
+  ),
+)
+
+#let _r(name) = ("$ref": "#/$defs/" + name)
+
+#let type-schema(ty) = {
+  let t = ty.t
+  if t == "text" {
+    (
+      (type: "string")
+        + if ty.max != none { (maxLength: ty.max) } else { (:) }
+        + if ty.pattern != none { (pattern: ty.pattern) } else { (:) }
+    )
+  } else if t == "lines" {
+    (anyOf: ((type: "string"), (type: "array", items: (type: "string"))))
+  } else if t == "decimal" {
+    if ty.positive { _r("decimal-positive") } else if (
+      ty.min != none and ty.min == 0
+    ) { _r("decimal-unsigned") } else { _r("decimal") }
+  } else if t == "percent" {
+    if ty.min == 0% and ty.max == 100% { _r("percent-0-100") } else if (
+      ty.min == 0%
+    ) { _r("percent-unsigned") } else { _r("percent") }
+  } else if t == "amount" { _r("amount") } else if t == "int" {
+    (
+      (type: "integer")
+        + if ty.min != none { (minimum: ty.min) } else { (:) }
+        + if ty.max != none { (maximum: ty.max) } else { (:) }
+    )
+  } else if t == "bool" { (type: "boolean") } else if t == "date" {
+    _r("date")
+  } else if t == "period" { _r("period") } else if t == "enum" {
+    (type: "string", enum: ty.values)
+  } else if t == "const" { (const: ty.value) } else if t == "ref" {
+    _r(ty.name)
+  } else if t == "array" {
+    (
+      (type: "array", items: type-schema(ty.of))
+        + if ty.min != none { (minItems: ty.min) } else { (:) }
+    )
+  } else if t == "map" {
+    (type: "object", additionalProperties: type-schema(ty.of))
+  } else if t == "any" { (:) } else if t == "union" {
+    (anyOf: ty.of.map(type-schema))
+  } else if t == "tagged" {
+    (oneOf: ty.cases.values().map(_r))
+  } else { panic("internal: unknown contract type " + repr(t)) }
+}
+
+// "key is given and not null" (the decoder reads null as absent)
+#let _present(k) = (
+  required: (k,),
+  properties: ((k): ("not": (type: "null"))),
+)
+
+#let field-schema(key, f) = {
+  let inner = type-schema(f.type)
+  if f.required and f.type.t == "text" { inner += (minLength: 1) }
+  let desc = (
+    (if f.doc != none { f.doc } else { "" })
+      + if f.bt != none { " (EN 16931 " + f.bt + ")" } else { "" }
+  ).trim()
+  let ann = (
+    ..if desc != "" { (description: desc) },
+    ..if f.example != none { (examples: (f.example,)) },
+    // an optional discriminator states its default case (codegen writes
+    // `kind: Literal["item"] = "item"`); no default of invoice() is copied
+    ..if f.type.t == "const" and not f.required { (default: f.type.value) },
+    ..if f.bt != none { (x-en16931: f.bt) },
+    ..if f.role != none { (x-invoice-pro-role: f.role) },
+    ..if f.bind != none { (x-invoice-pro-bind: f.bind) },
+    x-invoice-pro-since: f.since,
+  )
+  if f.required { inner + ann } else {
+    (anyOf: (inner, (type: "null"))) + ann
+  }
+}
+
+#let object-schema(obj) = {
+  let props = (:)
+  for (k, f) in obj.fields { props.insert(k, field-schema(k, f)) }
+  let required = obj
+    .fields
+    .pairs()
+    .filter(((k, f)) => f.required)
+    .map(p => p.first())
+  let rules = ()
+  for group in obj.exactly-one {
+    rules.push((oneOf: group.map(_present)))
+  }
+  for group in obj.at-most-one + obj.exclusive {
+    let pairs = ()
+    for (i, a) in group.enumerate() {
+      for b in group.slice(i + 1) {
+        pairs.push((allOf: (_present(a), _present(b))))
+      }
+    }
+    rules.push(("not": (anyOf: pairs)))
+  }
+  for (a, b) in obj.at("excludes-if-true", default: ()) {
+    rules.push((
+      "not": (
+        allOf: (
+          (required: (a,), properties: ((a): (const: true))),
+          _present(b),
+        ),
+      ),
+    ))
+  }
+  (
+    (type: "object")
+      + if obj.doc != none { (description: obj.doc) } else { (:) }
+      + (properties: props)
+      + if required.len() > 0 { (required: required) } else { (:) }
+      + (additionalProperties: obj.open)
+      + if rules.len() > 0 { (allOf: rules) } else { (:) }
+  )
+}
+
+/// The JSON Schema 2020-12 document of a descriptor.
+#let json-schema(objs, root: "invoice", id: none, title: none) = {
+  let defs = scalar-defs
+  for (name, obj) in objs {
+    if name != root { defs.insert(name, object-schema(obj)) }
+  }
+  let head = (
+    "$schema": "https://json-schema.org/draft/2020-12/schema",
+    ..if id != none { ("$id": id) },
+    ..if title != none { (title: title) },
+  )
+  head + object-schema(objs.at(root)) + ("$defs": defs)
+}
diff --git a/src/contract/hydrate.typ b/src/contract/hydrate.typ
new file mode 100644
index 0000000..9f71164
--- /dev/null
+++ b/src/contract/hydrate.typ
@@ -0,0 +1,160 @@
+// Hydration: applies a decoded record to one invoice() call. Loaded only by
+// a hydrated invoice (and by `invoice-data.load`/`decode`).
+//
+// The precedence is not written here per key: it is the `role` of each
+// field in schema.typ (`invoice-params`).
+//  - "design" (theme, locale, references, zugferd, ...): never data, passed
+//    through unchanged;
+//  - "issuer": the skeleton's value unless the data gives the key; a given
+//    value replaces it as a whole (no deep merge: a partial merge could pair
+//    the skeleton's VAT ID with another name);
+//  - "document" (and `custom`): from the data alone. A key the data lacks is
+//    LEFT OUT of the re-entered call, so invoice()'s own signature default
+//    applies: no default is copied anywhere, and a sample can never leak.
+// The body sections (items, modifiers, prepayments, payment) go sealed to
+// their binding points in the loom context.
+#import "schema.typ" as s
+#import "decode.typ": decode-document, region-pass
+#import "input.typ": is-record, resolve-data
+#import "../locale/lang/base.typ": base-language
+#import "../locale/region/base.typ": base-region
+#import "../validation/issue.typ": issue
+
+/// Decodes raw data into a record: sealed content, so it cannot be
+/// confused with raw data and travels through loom at no hashing cost.
+/// `origin`: what the data was read from ("input", "file", "value"), for the
+/// one-source rule.
+/// -> content
+#let make-record(raw, origin: "value", region: none, rates: none) = {
+  let d = decode-document(raw, region: region, rates: rates)
+  metadata((
+    kind: "invoice-pro-record",
+    format: if d.major == none { none } else {
+      s.family + "/" + str(d.major) + "." + str(d.minor)
+    },
+    origin: origin,
+    values: d.values,
+    issues: d.issues,
+    fatal: d.fatal,
+  ))
+}
+
+/// The VAT rates of a region (`"de"`), as its `infer-tax` knows them
+/// (`normalize.vat-rates` of the region), or `none`.
+/// -> none | array
+#let rates-of(region) = {
+  if type(region) != str { return none }
+  import "../locale/region/region.typ" as regions
+  let make = dictionary(regions).at(region, default: none)
+  if make == none { return none }
+  make(base-language).normalize.at("vat-rates", default: none)
+}
+
+// Required keys whose absence check-data reports (validation/data.typ): with
+// its inline marker and legal reference, once.
+#let _legal-checks = ("/invoice-nr", "/recipient", "/recipient/name", "/items")
+
+// The rows of the bulk motif (rows.typ) in print order: the items tree, the
+// document modifiers, the prepayments; a bundle's modifiers follow its items,
+// as in a hand-written bundle.
+#let _engine-row(r) = {
+  if r.kind == "bundle" {
+    r.items = r.items.map(_engine-row) + r.at("modifiers", default: ())
+    let _ = r.remove("modifiers", default: none)
+  } else if r.kind == "group" {
+    r.items = r.items.map(_engine-row)
+  }
+  r
+}
+#let engine-rows(v) = (
+  v.at("items", default: ()).map(_engine-row)
+    + v.at("modifiers", default: ())
+    + v.at("prepayments", default: ()).map(p => p + (kind: "prepayment"))
+)
+
+/// The arguments of the re-entered invoice() call and the applied marker,
+/// or `none` when the call is not hydrated. `given`: every parameter of the
+/// call as (name: value).
+/// -> none | dictionary
+#let hydrate(data, given, inputs: sys.inputs) = {
+  let src = resolve-data(data, inputs: inputs)
+  if src == none { return none }
+  let rec = if is-record(src) { src } else {
+    make-record(src.raw, origin: src.origin)
+  }
+  let r = rec.value
+  // another major version cannot be read at all: no level can honour it
+  if r.fatal != none { panic(r.fatal) }
+  // the region checks of the locale (a "16%" is no VAT rate of "de")
+  let loc = (given.locale)(base-language, base-region)
+  let region = lower(str(loc.meta.at("region", default: "")))
+  let rates = loc.at("normalize", default: (:)).at("vat-rates", default: none)
+  let (v, more) = region-pass(r.values, region, rates)
+  let issues = r.issues + more
+
+  let args = (:)
+  for (key, class) in s.invoice-params {
+    if class == "design" { args.insert(key, given.at(key)) } else if (
+      class == "issuer"
+    ) { args.insert(key, v.at(key, default: given.at(key))) } else if (
+      class == "document" and key in v
+    ) { args.insert(key, v.at(key)) }
+  }
+  // The small-business exemption excludes a tax, across the layers: the
+  // data's exemption drops the skeleton's tax; the data's tax under the
+  // skeleton's exemption is an issue (invoice() would stop).
+  if args.tax-exempt-small-biz == true and args.tax != auto {
+    if "tax" in v {
+      issues.push(issue(
+        "schema/tax",
+        "data",
+        "invoice data: `tax` is given, but the skeleton has `tax-exempt-small-biz: true`: give `\"tax-exempt-small-biz\": false` with it, or leave `tax` out.",
+        ref: s.format + " · tax",
+        key: "schema-exclusive",
+        args: (path: "/tax"),
+      ))
+    }
+    args.tax = auto
+  }
+  let sections = (
+    rows: engine-rows(v),
+    has-items: "items" in v or "modifiers" in v or "prepayments" in v,
+    // absent: the skeleton's payment(..) applies, its document details
+    // (mandate, card, paid) dropped
+    payment: v.at("payment", default: (:)),
+    has-payment: "payment" in v,
+    format: r.format,
+  )
+  (
+    args: args,
+    marker: metadata((
+      kind: "invoice-pro-applied",
+      issues: issues.filter(i => not (
+        i.key == "schema-required" and i.args.path in _legal-checks
+      )),
+      sections: sections,
+    )),
+  )
+}
+
+/// The arguments of `payment(..)` with the `payment` section applied by the
+/// roles of schema.typ (`own`: the arguments of the call).
+/// -> dictionary
+#let payment-args(own, data) = {
+  let args = own
+  for (key, f) in s.objects.payment.fields {
+    if key in data { args.insert(key, data.at(key)) } else if (
+      f.role == "document"
+    ) { args.insert(key, none) }
+  }
+  // details of a method without the method: that method
+  if (
+    "method" not in data
+      and ("direct-debit", "card", "paid").any(k => k in data)
+  ) { args.method = auto }
+  // a paid invoice has no terms (the root forbids paid + terms)
+  if args.method == "paid" or (args.method == auto and args.paid != none) {
+    args.terms = none
+  }
+  args
+}
diff --git a/src/contract/input.typ b/src/contract/input.typ
new file mode 100644
index 0000000..a9c722a
--- /dev/null
+++ b/src/contract/input.typ
@@ -0,0 +1,151 @@
+// Where invoice data comes from, and the rule "one source" (R7).
+//
+// The CLI contract ("one input = one JSON document"):
+//   --input invoice-pro-data=<JSON text>    read by invoice-pro itself
+//   --input invoice-pro-data-file=<path>    read by the skeleton's `read`
+//                                           callback (a package cannot open
+//                                           the user's files)
+// Embedders (typst as a library, phase 2) may pass a dictionary as the value
+// of `invoice-pro-data` instead of JSON text. Loaded only when an invoice is
+// hydrated (invoice.typ looks up the two keys itself) or by `invoice-data`.
+
+/// The `--input` key with the data of one invoice as JSON text.
+/// -> str
+#let input-key = "invoice-pro-data"
+/// The `--input` key with the path of a data file (.json, .toml, .yaml).
+/// -> str
+#let file-key = "invoice-pro-data-file"
+
+#let _short(s) = if s.len() > 60 { s.slice(0, 57) + "..." } else { s }
+
+#let _load-line = "`data: invoice-data.load(read: p => read(p, encoding: none))`"
+
+/// Whether `x` is a record of `invoice-data.load`/`decode` (sealed content).
+/// -> bool
+#let is-record(x) = (
+  type(x) == content
+    and x.func() == metadata
+    and type(x.value) == dictionary
+    and x.value.at("kind", default: none) == "invoice-pro-record"
+)
+
+#let _parse-text(s, origin) = {
+  let s = s.trim("\u{feff}", at: start)
+  if s.trim().starts-with("{") { return json(bytes(s)) }
+  panic(
+    origin
+      + " is not a JSON object: a string is JSON text, not a path. A package cannot open your files: for a file use --input "
+      + file-key
+      + "=<path> and "
+      + _load-line
+      + " in the skeleton.",
+  )
+}
+
+// A file read by the user's callback: the extension decides the format.
+#let _parse-file(path, read) = {
+  let raw = read(path)
+  let b = if type(raw) == str { bytes(raw) } else { raw }
+  let lower-path = lower(path)
+  if lower-path.ends-with(".toml") { toml(b) } else if (
+    lower-path.ends-with(".yaml") or lower-path.ends-with(".yml")
+  ) { yaml(b) } else {
+    // JSON; a byte order mark is tolerated (Typst's decoder rejects it)
+    let s = str(b).trim("\u{feff}", at: start)
+    json(bytes(s))
+  }
+}
+
+#let _two-sources(what) = panic(
+  "invoice data is given twice: "
+    + what
+    + ". An invoice is hydrated from ONE source: remove one of them.",
+)
+
+/// The raw data the CLI gives, or `none`: `(raw: .., origin: "input" |
+/// "file")`. `read`: a function defined in the skeleton, so that a path
+/// resolves against the skeleton and not inside the package.
+/// -> none | dictionary
+#let from-inputs(read: none, inputs: sys.inputs) = {
+  let has-data = input-key in inputs
+  let has-file = file-key in inputs
+  if has-data and has-file {
+    _two-sources("--input " + input-key + " and --input " + file-key)
+  }
+  if has-data {
+    let v = inputs.at(input-key)
+    let raw = if type(v) == dictionary { v } else {
+      _parse-text(v, "--input " + input-key + "=" + _short(v))
+    }
+    return (raw: raw, origin: "input")
+  }
+  if has-file {
+    if read == none {
+      panic(
+        "--input "
+          + file-key
+          + "="
+          + inputs.at(file-key)
+          + " needs one line in the skeleton, because a package cannot open your files: "
+          + _load-line
+          + ".",
+      )
+    }
+    return (raw: _parse-file(inputs.at(file-key), read), origin: "file")
+  }
+  none
+}
+
+/// Resolves `invoice(data: ..)`: `none` (not hydrated), a record, or
+/// `(raw: .., origin: ..)` to decode. Panics when a data input is given but
+/// would not be consumed, and when two sources are given (R7).
+/// -> none | content | dictionary
+#let resolve-data(data, inputs: sys.inputs) = {
+  let given = (input-key, file-key).filter(k => k in inputs)
+  if data == auto { return from-inputs(inputs: inputs) }
+  if data == none {
+    if given.len() > 0 {
+      panic(
+        "the CLI hands over invoice data (--input "
+          + given.first()
+          + "), but the skeleton says `data: none`, so the invoice would show its samples: remove `data: none`"
+          + if file-key in given { ", and write " + _load-line } else { "" }
+          + ".",
+      )
+    }
+    return none
+  }
+  if is-record(data) {
+    // every data input must be the one the record read
+    let origin = data.value.at("origin", default: "value")
+    let unread = given.filter(k => not (
+      (k == input-key and origin == "input")
+        or (k == file-key and origin == "file")
+    ))
+    if unread.len() > 0 {
+      _two-sources(
+        "--input " + unread.first() + " and a record of invoice-data.decode",
+      )
+    }
+    return data
+  }
+  if given.len() > 0 {
+    _two-sources("--input " + given.first() + " and `invoice::data`")
+  }
+  if type(data) == dictionary { return (raw: data, origin: "value") }
+  if type(data) == bytes {
+    return (raw: _parse-text(str(data), "`invoice::data`"), origin: "value")
+  }
+  if type(data) == str {
+    return (
+      raw: _parse-text(data, "`invoice::data`(\"" + _short(data) + "\")"),
+      origin: "value",
+    )
+  }
+  // Typst 0.15: a `path` made in the user's file crosses the package boundary
+  if str(type(data)) == "path" { return (raw: json(data), origin: "value") }
+  panic(
+    "variable `invoice::data` must be of auto | none | dictionary | bytes | str (JSON text) | a record of invoice-data.load/decode, found "
+      + str(type(data)),
+  )
+}
diff --git a/src/contract/result-schema.typ b/src/contract/result-schema.typ
new file mode 100644
index 0000000..dc019d6
--- /dev/null
+++ b/src/contract/result-schema.typ
@@ -0,0 +1,110 @@
+// The shape of the result "invoice-pro-result/1", declared with the
+// vocabulary of the input format, so `invoice-data.schema(kind: "result")`
+// exports it as a JSON Schema. Loaded only by `schema`: the result record
+// itself (result.typ) never loads a descriptor.
+#import "types.typ" as t
+#import "types.typ": field, object
+
+/// The format of the result.
+/// -> str
+#let format = "invoice-pro-result/1"
+/// The `$id` of its JSON Schema (the format major only, no package version).
+/// -> str
+#let schema-id = "https://invoice-pro.dev/schema/invoice-pro/1/result.schema.json"
+
+#let _req(ty, doc) = field(ty, doc: doc, required: true)
+#let _opt(ty, doc) = field(ty, doc: doc)
+
+/// The result as a descriptor (for its JSON Schema and documentation).
+#let objects = (
+  result: object(doc: "The result of one compiled invoice.", (
+    format: _req(t.const(format), "Format and version of the result."),
+    package: _req(t.text(), "invoice-pro version that compiled it."),
+    data-format: _req(
+      t.union(t.text(), t.const(none)),
+      "Format of the hydrating data (\"invoice-pro/1.0\"), null when not hydrated.",
+    ),
+    status: _req(
+      t.enum("ok", "draft", "unchecked"),
+      "ok: no problem found; draft: problems found, rendered as a draft and the e-invoice withheld; unchecked: validation none.",
+    ),
+    validation: _req(
+      t.enum("none", "draft", "strict"),
+      "The validation level in effect.",
+    ),
+    invoice-nr: _req(
+      t.union(t.text(), t.const(none)),
+      "Invoice number (BT-1).",
+    ),
+    date: _req(t.union(t.date(), t.const(none)), "Issue date (BT-2)."),
+    due-date: _req(
+      t.union(t.date(), t.const(none)),
+      "Due date (BT-9): the invoice's own, else that of the payment terms.",
+    ),
+    currency: _req(t.text(), "Invoice currency (BT-5)."),
+    document-type: _req(t.text(), "UNTDID 1001 code (BT-3)."),
+    recipient: _req(t.union(t.text(), t.const(none)), "Buyer name (BT-44)."),
+    totals: _req(t.ref("totals"), "Document totals (BG-22)."),
+    taxes: _req(t.array(t.ref("tax-line")), "VAT breakdown (BG-23)."),
+    lines: _req(t.integer(min: 0), "Number of invoice lines (BG-25)."),
+    issues: _req(t.array(t.ref("issue")), "Problems the validation found."),
+    e-invoice: _req(t.ref("e-invoice"), "Outcome of the e-invoice."),
+  )),
+  totals: object(doc: "Document totals as decimal strings.", (
+    net: _req(
+      t.decimal(),
+      "Sum of net line amounts after allowances (BT-109).",
+    ),
+    tax: _req(t.decimal(), "Total VAT (BT-110)."),
+    gross: _req(t.decimal(), "Total with VAT (BT-112)."),
+    prepaid: _req(t.decimal(), "Paid amount (BT-113)."),
+    due: _req(t.decimal(), "Amount due for payment (BT-115)."),
+  )),
+  tax-line: object(doc: "One VAT category and rate.", (
+    category: _req(t.text(), "UNTDID 5305 category (BT-118)."),
+    rate: _req(t.percent(), "Rate (BT-119)."),
+    basis: _req(t.decimal(), "Taxable amount (BT-116)."),
+    amount: _req(t.decimal(), "VAT amount (BT-117)."),
+    code: _opt(t.text(), "VATEX exemption reason code (BT-121)."),
+  )),
+  issue: object(doc: "A problem the validation found.", (
+    id: _req(
+      t.text(),
+      "Stable id; schema/<JSON pointer> for problems of the data.",
+    ),
+    class: _req(t.enum("data", "theme", "lint"), "Issue class."),
+    path: _req(
+      t.union(t.text(), t.const(none)),
+      "JSON Pointer into the data, for problems of the data.",
+    ),
+    message: _req(t.text(), "Message in English."),
+    ref: _opt(t.text(), "Legal or normative reference."),
+  )),
+  e-invoice: object(
+    doc: "Outcome of the e-invoice (ZUGFeRD / Factur-X / XRechnung).",
+    (
+      requested: _req(
+        t.union(t.text(), t.const(none)),
+        "The `zugferd` profile asked for, null for none.",
+      ),
+      profile: _req(t.union(t.text(), t.const(none)), "The profile written."),
+      status: _req(
+        t.enum("none", "attached", "draft", "withheld"),
+        "none: not requested; attached: valid XML attached; draft: XML with errors attached as invoice-draft.xml; withheld: not attached because data issues are open.",
+      ),
+      file: _req(t.union(t.text(), t.const(none)), "Name of the attached XML."),
+      errors: _req(t.integer(min: 0), "Number of errors."),
+      warnings: _req(t.integer(min: 0), "Number of warnings."),
+      diagnostics: _req(t.array(t.ref("diagnostic")), "Rule findings."),
+    ),
+  ),
+  diagnostic: object(doc: "A finding of the e-invoice rules.", (
+    level: _req(t.enum("error", "warning"), "Severity."),
+    rule: _req(t.text(), "Rule id (BR-…, IP-…)."),
+    field: _req(
+      t.union(t.text(), t.const(none)),
+      "Input path the rule refers to.",
+    ),
+    message: _req(t.text(), "Message."),
+  )),
+)
diff --git a/src/contract/result.typ b/src/contract/result.typ
new file mode 100644
index 0000000..f12442a
--- /dev/null
+++ b/src/contract/result.typ
@@ -0,0 +1,142 @@
+// The result contract "invoice-pro-result/1": what a program that generated
+// an invoice needs back (number, totals, VAT breakdown, the problems found,
+// the e-invoice outcome), in ONE labelled metadata per invoice. Emitted by
+// root for a hydrated invoice, or with `--input invoice-pro-result=1`.
+// Loaded only then (root.typ), and it loads no descriptor: its JSON Schema is
+// declared in result-schema.typ.
+//
+// Values are JSON-friendly: strings for decimals, percentages and dates
+// (Typst's encoders would write `decimal("12.30")`), integers, booleans,
+// null.
+#import "../utils/text.typ": plain-text
+
+#let format = "invoice-pro-result/1"
+
+// ---- values -------------------------------------------------------------------
+
+#let _s(v) = if v == none or v == auto { none } else if type(v) == datetime {
+  v.display("[year]-[month]-[day]")
+} else if type(v) in (decimal, int) { str(v) } else if type(v) == float {
+  str(decimal(str(v)))
+} else if type(v) == str { v } else if type(v) == content {
+  plain-text(v)
+} else {
+  repr(v)
+}
+#let _date(v) = if type(v) == datetime { _s(v) } else { none }
+// a tax rate (decimal fraction or ratio) as "19%"
+#let _pct(r) = {
+  let d = if type(r) == ratio { decimal(str(float(r))) } else if (
+    type(r) == float
+  ) {
+    decimal(str(r))
+  } else { decimal(r) }
+  let x = str(d * 100)
+  if x.contains(".") { x = x.trim("0", at: end).trim(".", at: end) }
+  x + "%"
+}
+#let _ptr-of(i) = if i.id.starts-with("schema/") or i.id == "schema" {
+  i.id.slice(6)
+} else { none }
+
+#let _version = toml("../../typst.toml").package.version
+
+// The due date as the e-invoice states it (BT-9, zugferd/model.typ): the
+// invoice's own, else the date of the payment terms, else date + days.
+#let _due-date(ctx, view) = {
+  let own = ctx.at("due-date", default: none)
+  if type(own) == datetime { return own }
+  let goal = view.at("payment-terms", default: none)
+  if goal == none { return none }
+  let d = goal.at("date", default: none)
+  if type(d) == datetime { return d }
+  let days = goal.at("days", default: none)
+  let date = ctx.at("invoice-date", default: none)
+  if type(days) == int and type(date) == datetime {
+    date + duration(days: days)
+  }
+}
+
+/// The result record of one invoice (root.typ draw).
+#let result-record(ctx, view, issues, withheld, e-result) = {
+  let level = ctx.validation.level
+  let d = ctx.at("hydration", default: none)
+  let d = if type(d) == content { d.value } else { d }
+  let total = view.total
+  let taxes = view.item-data.at("taxes", default: (:)).values()
+  let tax-total = taxes
+    .map(x => x.at("absolute", default: decimal("0")))
+    .fold(decimal("0"), (a, b) => a + b)
+  let diagnostics = if e-result == none { () } else { e-result.diagnostics }
+  let errors = diagnostics.filter(x => x.level == "error").len()
+  let requested = if ctx.zugferd == none { none } else if ctx.zugferd == auto {
+    "auto"
+  } else { ctx.zugferd }
+  let draft-xml = errors > 0 and ctx.zugferd-errors == "report"
+  (
+    format: format,
+    package: _version,
+    data-format: if d == none { none } else { d.format },
+    status: if level == none { "unchecked" } else if issues.len() > 0 {
+      "draft"
+    } else { "ok" },
+    validation: if level == none { "none" } else { level },
+    invoice-nr: _s(ctx.at("invoice-nr", default: none)),
+    date: _date(ctx.at("invoice-date", default: none)),
+    due-date: _date(_due-date(ctx, view)),
+    currency: ctx.locale.currency.code,
+    document-type: ctx.at("document-type", default: (code: "380")).code,
+    recipient: _s(ctx.recipient.at("name-inline", default: ctx.recipient.at(
+      "name",
+      default: none,
+    ))),
+    totals: (
+      net: _s(total.net),
+      tax: _s(tax-total),
+      gross: _s(total.gross),
+      prepaid: _s(total.prepaid),
+      due: _s(total.due),
+    ),
+    taxes: taxes.map(x => (
+      category: x.category,
+      rate: _pct(x.rate),
+      basis: _s(x.at("basis", default: decimal("0"))),
+      amount: _s(x.at("absolute", default: decimal("0"))),
+      ..if x.at("codes", default: ()).len() > 0 { (code: x.codes.first()) },
+    )),
+    lines: view.item-data.at("items", default: ()).len(),
+    issues: issues.map(i => (
+      id: i.id,
+      class: i.class,
+      path: _ptr-of(i),
+      message: i.message,
+      ..if i.at("ref", default: none) != none { (ref: i.ref) },
+    )),
+    e-invoice: (
+      requested: requested,
+      profile: if e-result != none { e-result.profile.id },
+      status: if requested == none { "none" } else if withheld {
+        "withheld"
+      } else if draft-xml { "draft" } else { "attached" },
+      file: if e-result == none { none } else if draft-xml {
+        "invoice-draft.xml"
+      } else { e-result.profile.at("file-name", default: "factur-x.xml") },
+      errors: errors,
+      warnings: diagnostics.len() - errors,
+      diagnostics: diagnostics.map(x => (
+        level: x.level,
+        rule: x.rule,
+        field: _s(x.field),
+        message: _s(x.message),
+      )),
+    ),
+  )
+}
+
+/// The labelled metadata element of the result, read by
+/// `typst query <file> "<invoice-pro-result>"` (0.14) or `typst eval
+/// 'query(<invoice-pro-result>).first().value' --in <file>` (0.15).
+/// -> content
+#let result-element(ctx, view, issues, withheld, e-result) = [#metadata(
+    result-record(ctx, view, issues, withheld, e-result),
+  )<invoice-pro-result>]
diff --git a/src/contract/rows.typ b/src/contract/rows.typ
new file mode 100644
index 0000000..40bccac
--- /dev/null
+++ b/src/contract/rows.typ
@@ -0,0 +1,352 @@
+// The line items of hydrated data as ONE loom motif (design C's engine).
+//
+// The binding point (`items-slot`, the body of every `line-items`, or the
+// explicit `invoice-data.items[..]` marker) replaces N `item` / `group` /
+// `bundle` / `discount` / `surcharge` / `prepayment` motifs by one raw motif
+// whose `measure` emits exactly the frames those motifs emit (kinds "item",
+// "group", "bundle", "modifier", "prepayment"), so line-items, the
+// applicators, resolve-tree, the theme parts and the e-invoice stay as they
+// are. Loaded only by a hydrated invoice or a skeleton with a marker.
+//
+// Speed rules (measured, see design/C-performance.md):
+// 1. `compute(rows, env)` is a PURE function of decoded rows and a small,
+//    pass-independent environment: Typst memoizes it, so loom's second pass
+//    is a cache hit. `env` never holds `global` or `sys.pass`.
+// 2. No loom.mutator per row (each op hashes the full ctx, ~22 us): the
+//    cascade of item/group/bundle scopes is replayed on a small dictionary.
+// 3. The locale travels sealed (metadata) into the per-unit helper, so its
+//    215 leaves are not hashed per call.
+#import "../loom-wrapper.typ": loom, loom-key, motif
+#import "../logic/calc-item.typ": calculate-item-data
+#import "../logic/calc-bundle.typ": calculate-bundle
+#import "../logic/modifier-applicator.typ": calculate-modifier
+#import "../logic/unit.typ" as unit-logic
+#import "../public/unit.typ" as m-unit
+#import "../data/tax.typ" as m-tax
+#import "../utils/coercion.typ"
+#import "../theming/access.typ": row-style-of
+#import "../components/item.typ": evaluate-modifier
+
+// ctx keys the scopes of item/bundle/modifier/prepayment read from their
+// parent (set by line-items, group, bundle or `apply` around the slot)
+#let _cascade-keys = (
+  "description",
+  "quantity",
+  "base-quantity",
+  "unit",
+  "date",
+  "item-price",
+  "item-total",
+  "tax-mode",
+  "input-gross",
+  "item-id",
+  "reference",
+  "modifier",
+  "label",
+  "name",
+  "method",
+)
+
+#let _or(v, d) = if v == none { d } else { v }
+
+/// The environment of the slot, taken from its ctx ONCE per pass. Small and
+/// identical in both loom passes, so `compute` is memoized.
+#let env-of(ctx) = {
+  let c = (:)
+  for k in _cascade-keys { if k in ctx { c.insert(k, ctx.at(k)) } }
+  // the item scope resolves a cascaded tax (a raw ratio from
+  // `line-items(tax: 19%)`, `none` = implicit zero)
+  c.tax = if "tax" in ctx { m-tax.resolve(ctx, ctx.tax, "item") } else {
+    m-tax.implicit-zero()
+  }
+  if "modifier" in c and c.modifier not in (auto, none) {
+    c.modifier = evaluate-modifier(ctx, c.modifier)
+  }
+  let locale = ctx.locale
+  let strings = locale.at("strings", default: (:))
+  let li = strings.at("line-items", default: (:))
+  (
+    c: c,
+    small-biz: if ctx.at("tax-exempt-small-biz", default: false) {
+      locale.tax.small-enterprise-special-scheme
+    } else { none },
+    // what calc-item / calc-bundle / calc-modifier read of the locale
+    lite-locale: (
+      normalize: (
+        money: locale.normalize.money,
+        money-fine: locale.normalize.money-fine,
+      ),
+      format: (percent: locale.format.percent),
+      strings: (line-items: (conjunction: li.at("conjunction", default: "and"))),
+    ),
+    infer-tax: locale.at("normalize", default: (:)).at("infer-tax", default: none),
+    labels: (
+      discount: li.at("discount", default: "Discount"),
+      surcharge: li.at("surcharge", default: "Surcharge"),
+      prepayment: strings.at("summary", default: (:)).at("prepayment", default: "Prepayment"),
+    ),
+    format-date: locale.format.date,
+    sealed-locale: metadata(locale),
+    style: row-style-of(ctx),
+    path: loom.path.get(ctx),
+  )
+}
+
+// memoized per (unit, quantity): the locale is sealed, hashing is cheap
+#let _unit(u, q, sealed-locale, default) = unit-logic.resolve(
+  u,
+  sealed-locale.value,
+  quantity: q,
+  default: default,
+)
+
+#let _resolve-tax(env, t) = {
+  if type(t) == ratio {
+    if env.infer-tax == none { panic("item::tax can not be of type `ratio`.") }
+    (env.infer-tax)(t)
+  } else { m-tax.to-tax(t) }
+}
+
+#let _frame(kind, path, signal) = loom.frame.new(
+  kind: kind,
+  key: path.last(default: ("unknown",)),
+  path: path,
+  signal: signal,
+)
+
+// `modifier` measure, from a decoded modifier row and the cascade `c`
+#let modifier-signal(env, c, m) = {
+  let kind = m.kind
+  let raw = m.at("amount", default: decimal("0"))
+  let amount = if kind == "discount" { -raw } else { raw }
+  let is-discount = if kind == "discount" { true } else if kind == "surcharge" {
+    false
+  } else { auto }
+  let tax = m.at("tax", default: auto)
+  let modifier-tax = if tax == auto { none } else if env.small-biz != none {
+    env.small-biz
+  } else { _resolve-tax(env, tax) }
+  let description = m.at("description", default: c.at("description", default: none))
+  let input-gross = m.at("input-gross", default: _or(
+    c.at("input-gross", default: none),
+    c.at("tax-mode", default: "exclusive") == "inclusive",
+  ))
+  let label = m.at("label", default: _or(c.at("label", default: none), auto))
+
+  let (value, type-) = if type(amount) == ratio {
+    (coercion.to-ratio(amount), "relative")
+  } else { ((env.lite-locale.normalize.money)(amount), "absolute") }
+  let discount-mode = if is-discount != auto { is-discount } else { value < 0 }
+  (
+    name: m.name,
+    label: if label == auto {
+      if discount-mode { env.labels.discount } else { env.labels.surcharge }
+    } else { label },
+    description: description,
+    type: type-,
+    amount: value,
+    is-gross: input-gross,
+    tax: modifier-tax,
+  )
+}
+
+// the item scope (item.typ:200-293) replayed on `c`, then the unchanged
+// `calculate-item-data`
+#let item-signal(env, c, row) = {
+  let q = row.at("quantity", default: auto)
+  let quantity = if q != auto { q } else {
+    _or(c.at("quantity", default: none), decimal("1"))
+  }
+  let bq = row.at("base-quantity", default: auto)
+  let unit-input = row.at("unit", default: c.at("unit", default: auto))
+  let unit-q = if q != auto { q } else { c.at("quantity", default: decimal("1")) }
+  let t = row.at("tax", default: auto)
+  let tax = if t == auto { c.tax } else { _resolve-tax(env, t) }
+  if env.small-biz != none { tax = env.small-biz }
+  let mods = if "modifiers" in row {
+    row.modifiers.map(m => {
+      let s = modifier-signal(env, c, m)
+      (
+        name: s.name,
+        label: s.label,
+        amount: if s.type == "relative" { float(s.amount) * 100% } else {
+          s.amount
+        },
+        description: s.description,
+        tax: s.tax,
+      )
+    })
+  } else { _or(c.at("modifier", default: none), ()) }
+  let ictx = (
+    locale: env.lite-locale,
+    description: row.at("description", default: c.at("description", default: none)),
+    quantity: quantity,
+    base-quantity: if bq != auto { bq } else {
+      _or(c.at("base-quantity", default: none), decimal("1"))
+    },
+    unit: _unit(unit-input, unit-q, env.sealed-locale, m-unit.pc),
+    unit-singular: _unit(unit-input, decimal("1"), env.sealed-locale, m-unit.pc),
+    date: row.at("date", default: c.at("date", default: none)),
+    item-price: row.at("price", default: _or(c.at("item-price", default: none), auto)),
+    item-total: row.at("total", default: _or(c.at("item-total", default: none), auto)),
+    tax-mode: _or(c.at("tax-mode", default: none), "exclusive"),
+    input-gross: row.at("input-gross", default: _or(
+      c.at("input-gross", default: none),
+      c.at("tax-mode", default: "exclusive") == "inclusive",
+    )),
+    tax: tax,
+    item-id: row.at("item-id", default: c.at("item-id", default: none)),
+    reference: row.at("reference", default: c.at("reference", default: none)),
+    modifier: mods,
+    ..if "note" in row { (note: row.note) },
+    ..if "origin" in row { (origin: row.origin) },
+  )
+  let signal = calculate-item-data(ictx, row.name) + (style: env.style)
+  if "custom" in row { signal.insert("custom", row.custom) }
+  signal
+}
+
+#let prepayment-signal(env, c, p) = {
+  let raw = calc.abs(p.amount)
+  let rel = type(raw) == ratio
+  let get(k) = p.at(k, default: c.at(k, default: none))
+  let label = p.at("label", default: _or(c.at("label", default: none), auto))
+  let date = get("date")
+  (
+    name: get("name"),
+    label: if label == auto { env.labels.prepayment } else { label },
+    date: if date == auto or date == none { none } else if type(date) == datetime {
+      (env.format-date)(date)
+    } else { date },
+    reference: get("reference"),
+    description: get("description"),
+    method: get("method"),
+    type: if rel { "relative" } else { "absolute" },
+    raw-amount: raw,
+    amount: if rel { coercion.to-ratio(raw) } else {
+      (env.lite-locale.normalize.money)(raw)
+    },
+  )
+}
+
+/// Frames of a list of decoded rows under the cascade `c` at `path`.
+#let frames-of(env, c, rows, path) = {
+  let out = ()
+  for (i, row) in rows.enumerate() {
+    let kind = row.kind
+    let p = path + ((kind, i),)
+    if kind == "item" {
+      out.push(_frame("item", p, item-signal(env, c, row)))
+    } else if kind in ("discount", "surcharge", "modifier") {
+      out.push(_frame("modifier", p, modifier-signal(env, c, row)))
+    } else if kind == "prepayment" {
+      out.push(_frame("prepayment", p, prepayment-signal(env, c, row)))
+    } else if kind == "group" {
+      // group.typ scope: input-gross, date, tax (resolved) and the
+      // unresolved unit cascade; the description does not
+      let g = c
+      if "input-gross" in row { g.input-gross = row.input-gross }
+      if row.at("date", default: none) != none { g.date = row.date }
+      if "tax" in row { g.tax = _resolve-tax(env, row.tax) }
+      if row.at("unit", default: none) != none { g.unit = row.unit }
+      out.push(_frame("group", p, (
+        kind: "group",
+        name: row.name,
+        description: row.at("description", default: none),
+        show-subtotal: row.at("show-subtotal", default: true),
+        style: env.style,
+        children: frames-of(env, g, row.items, p),
+      )))
+    } else if kind == "bundle" {
+      // bundle.typ scope
+      let bq = row.at("quantity", default: decimal("1"))
+      let bunit = row.at("unit", default: c.at("unit", default: auto))
+      let b = c
+      b.description = row.at("description", default: c.at("description", default: none))
+      let _ = b.remove("quantity", default: none)
+      let _ = b.remove("base-quantity", default: none)
+      let _ = b.remove("modifier", default: none)
+      b.date = row.at("date", default: c.at("date", default: none))
+      b.input-gross = row.at("input-gross", default: _or(
+        c.at("input-gross", default: none),
+        c.at("tax-mode", default: "exclusive") == "inclusive",
+      ))
+      b.tax-mode = _or(c.at("tax-mode", default: none), "exclusive")
+      if "tax" in row { b.tax = _resolve-tax(env, row.tax) }
+      b.item-id = row.at("item-id", default: c.at("item-id", default: none))
+      b.reference = row.at("reference", default: c.at("reference", default: none))
+      b.bundle-quantity = bq
+      let kids = frames-of(env, b, row.items, p)
+      let bctx = (
+        locale: env.lite-locale,
+        tax-mode: b.tax-mode,
+        bundle-description: c.at("description", default: row.at("description", default: auto)),
+        bundle-quantity: bq,
+        bundle-base-quantity: row.at("base-quantity", default: decimal("1")),
+        bundle-unit: _unit(bunit, bq, env.sealed-locale, m-unit.pcs),
+        bundle-unit-singular: _unit(bunit, decimal("1"), env.sealed-locale, m-unit.pcs),
+        bundle-date: row.at("date", default: c.at("date", default: auto)),
+        item-id: b.item-id,
+        reference: b.reference,
+        theme: (options: (row: env.style)),
+        sys: (path: p),
+      )
+      let app = _frame("modifier-applicator", p, calculate-modifier(bctx, kids))
+      let children = (app,) + kids.filter(k => k.kind != "modifier")
+      out.push(_frame("bundle", p, calculate-bundle(bctx, children, row.name)))
+    }
+  }
+  out
+}
+
+/// PURE: all frames of the rows. Called once per loom pass with identical
+/// arguments, so the second call is a memo hit.
+#let compute(rows, env) = frames-of(env, env.c, rows, env.path)
+
+#let _sections(ctx) = {
+  let h = ctx.at("hydration", default: none)
+  if type(h) == content { h.value } else { h }
+}
+
+// The frame a marker leaves for the slot of its `line-items`, which removes
+// it (components/line-items.typ): the rows of the data are placed already.
+#let _marker-kind = "invoice-data-items"
+
+/// The explicit binding point `invoice-data.items[..]`: without data the
+/// `sample` renders exactly as written; hydrated, the rows of the data take
+/// its place and the sample is never traversed (it is held in this closure,
+/// not in the motif's body). Rows outside it stay (a fixed fee). It must be
+/// a direct child of `line-items` (an `apply` around it is transparent).
+/// -> content
+#let items-marker(sample) = motif(
+  measure: (ctx, _) => {
+    let parent = loom.path.get(ctx).last(default: (none, none)).first()
+    if parent != "line-items" {
+      panic(
+        "`invoice-data.items[..]` must be a direct child of `line-items` (it places groups, modifiers and prepayments of the data), found it inside "
+          + if parent == none { "no `line-items`" } else {
+            "a `" + parent + "`"
+          }
+          + ".",
+      )
+    }
+    let marker = loom.frame.new(kind: _marker-kind)
+    let h = _sections(ctx)
+    if h == none {
+      let (_, frames) = loom.core.intertwine(
+        ctx,
+        sample,
+        key: loom-key,
+        draw: false,
+      )
+      return ((frames, marker), false)
+    }
+    ((compute(h.rows, env-of(ctx)), marker), true)
+  },
+  draw: (ctx, _, hydrated, _) => {
+    if not hydrated {
+      loom.core.intertwine(ctx, sample, key: loom-key, draw: true).at(0)
+    }
+  },
+  none,
+)
