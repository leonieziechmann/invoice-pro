+        bt: "BT-72/BG-14",
+        role: "document",
+      ),
+      subject: field(
+        t.text(),
+        doc: "Subject line; absent = the skeleton's (else the title of the document type and the number).",
+        role: "issuer",
+      ),
+      notes: field(
+        _notes,
+        doc: "Invoice notes: a text, or a list of texts and {text, subject-code}.",
+        bt: "BG-1",
+        role: "issuer",
+      ),
+      customer-nr: field(
+        t.text(),
+        doc: "Customer number (printed).",
+        role: "document",
+      ),
+      order-nr: field(
+        t.text(),
+        doc: "Purchase order reference.",
+        bt: "BT-13",
+        role: "document",
+      ),
+      order-date: field(
+        t.date(),
+        doc: "Date of the order (printed).",
+        role: "document",
+      ),
+      project: field(
+        t.text(),
+        doc: "Project reference.",
+        bt: "BT-11",
+        role: "document",
+      ),
+      contract-nr: field(
+        t.text(),
+        doc: "Contract reference.",
+        bt: "BT-12",
+        role: "document",
+      ),
+      quote-nr: field(
+        t.text(),
+        doc: "Quote number (printed).",
+        role: "document",
