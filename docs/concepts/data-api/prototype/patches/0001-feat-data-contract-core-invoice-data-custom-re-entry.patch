+        doc: "Your own fields: theme parts read ctx.custom, the body info.get(\"custom\", ..); never interpreted, never in the e-invoice. Replaces the skeleton's sample custom as a whole.",
+        role: "document",
+      ),
+    ),
+  ),
+  // ---- parties (zugferd/model.typ `party-keys`) ------------------------------
+  seller: object(
+    partial: true,
+    doc: "The seller (BG-4).",
+    _address("BT-27", "BT-35", "BT-37/BT-38", "BT-40")
+      + (
+        trading-name: field(t.text(), doc: "Trading name.", bt: "BT-28"),
+        vat-id: field(t.text(), doc: "VAT identifier.", bt: "BT-31"),
+        tax-nr: field(t.text(), doc: "Tax registration number.", bt: "BT-32"),
+        id: field(_identifier, doc: "Seller identifier.", bt: "BT-29"),
+        global-id: field(
+          _identifier,
+          doc: "Global seller identifier (GLN, DUNS, …).",
+          bt: "BT-29",
+        ),
+        legal-id: field(
+          _identifier,
+          doc: "Legal registration (e.g. {scheme: \"register\", id: \"HRB 12345\", court: \"Amtsgericht Berlin\"}).",
+          bt: "BT-30",
+        ),
+        legal-info: field(
+          t.lines(),
+          doc: "Additional legal information.",
+          bt: "BT-33",
+        ),
+        electronic-address: field(
+          _identifier,
+          doc: "Electronic address: an e-mail, or {scheme, id}.",
+          bt: "BT-34",
+        ),
+        contact: _contact,
+        tax-representative: field(
+          t.ref("tax-representative"),
+          doc: "Seller's tax representative.",
+          bt: "BG-11",
+        ),
+        register: field(t.text(), doc: "Register entry (printed only)."),
+        management: field(t.lines(), doc: "Management (printed only)."),
+      ),
+  ),
+  buyer: object(
+    partial: true,
+    doc: "The buyer (BG-7).",
+    exclusive: (("buyer-reference", "leitweg-id"),),
+    _address("BT-44", "BT-50", "BT-52/BT-53", "BT-55")
+      + (
+        trading-name: field(t.text(), doc: "Trading name.", bt: "BT-45"),
+        vat-id: field(t.text(), doc: "VAT identifier.", bt: "BT-48"),
+        tax-nr: field(t.text(), doc: "Tax number (printed only)."),
+        id: field(_identifier, doc: "Buyer identifier.", bt: "BT-46"),
+        global-id: field(
+          _identifier,
+          doc: "Global buyer identifier.",
+          bt: "BT-46",
+        ),
+        legal-id: field(
+          _identifier,
+          doc: "Legal registration identifier.",
+          bt: "BT-47",
+        ),
+        electronic-address: field(
+          _identifier,
+          doc: "Electronic address: an e-mail, or {scheme, id}.",
+          bt: "BT-49",
+        ),
+        contact: field(t.ref("contact"), doc: "Contact person.", bt: "BG-9"),
+        buyer-reference: field(
+          t.text(),
+          doc: "Buyer reference.",
+          bt: "BT-10",
+        ),
