+  custom: field(
+    t.ref("custom-party"),
+    doc: "Your own fields: read by theme parts as ctx.<party>.custom; never printed or in the e-invoice by invoice-pro.",
+  ),
+)
+
+#let _contact = field(
+  t.ref("contact"),
+  doc: "Contact person.",
+  bt: "BG-6",
+)
+
+// ---- the objects --------------------------------------------------------------
