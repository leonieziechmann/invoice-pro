+// The invoice data format "invoice-pro/1": the single source of truth.
+//
+// Every key the format knows is declared ONCE here, with its type, its
+// EN 16931 business term, its precedence role and a sentence of
+// documentation. decode.typ reads this table to decode and validate data,
+// hydrate.typ to apply it to invoice() (by role, re-entering invoice() so
+// that absent document keys take the signature's own defaults: no default
+// is copied here), export.typ to write the JSON Schema. Keys are the names of
+// the Typst API (kebab-case); the format is the canonical, JSON-friendly
+// subset of it: one encoding per concept (no `street` alias, no flat
+// `contact-name`, units as codes only, taxes as "19%" or an object).
+#import "types.typ" as t
+#import "types.typ": field, object
+
+/// The format family and the version this package reads.
+#let family = "invoice-pro"
+#let major = 1
+#let minor = 0
+#let format = family + "/" + str(major)
+/// The canonical `$id` of the JSON Schema (no package version in it: the
+/// format is versioned on its own, SchemaVer-style).
+#let schema-id = "https://invoice-pro.dev/schema/invoice-pro/1/invoice.schema.json"
+
+// ---- shared types -----------------------------------------------------------
+
+#let _tax-categories = (
+  "S",
+  "Z",
+  "E",
+  "AE",
+  "K",
+  "G",
+  "O",
+  "L",
+  "M",
+  "A",
+  "AA",
+  "AB",
+  "AC",
+  "AD",
+  "B",
+  "C",
+  "D",
+  "F",
+  "H",
+  "I",
+  "J",
+  "N",
+)
+/// UN/ECE Recommendation 20 codes the unit module knows (BT-130), mapped to
+/// the `unit.*` function that prints them in the locale's language. The
+/// format takes codes only (any Rec 20 code by pattern, e.g. "KWH"; one
+/// spelling per unit: a second spelling broke the Rust code generator); the
+/// codes not listed here print as the code itself.
+#let unit-codes = (
+  H87: "piece",
+  SET: "set",
+  PR: "pair",
+  LS: "lump-sum",
+  HUR: "hour",
+  DAY: "day",
+  MON: "month",
+  ANN: "year",
+  KGM: "kilogram",
+  GRM: "gram",
+  TNE: "tonne",
+  MTR: "metre",
+  MTK: "square-metre",
+  MMT: "millimetre",
+  CMT: "centimetre",
+  KMT: "kilometre",
+  LTR: "litre",
+  MTQ: "cubic-metre",
+)
+
+#let _tax = t.union(
+  t.percent(min: 0%),
+  t.ref("tax"),
+  conv: "tax",
+)
+#let _unit = t.union(
+  t.text(
+    pattern: "^[A-Z0-9]{2,3}$",
+    pattern-doc: "a UN/ECE Rec 20 unit code such as \"HUR\" or \"H87\"",
+    example: "HUR",
+  ),
+  t.ref("unit"),
+  conv: "unit",
+)
+#let _identifier = t.union(t.text(), t.ref("identifier"), conv: "identifier")
+#let _city = t.union(t.text(), t.ref("city"), conv: "city")
+#let _country = t.text(
+  pattern: "^[A-Za-z]{2}$",
+  pattern-doc: "an ISO 3166-1 alpha-2 code such as \"DE\"",
+  example: "DE",
+)
+#let _currency = t.text(
+  pattern: "^[A-Z]{3}$",
+  pattern-doc: "an ISO 4217 code such as \"EUR\"",
+  example: "EUR",
+)
+#let _iban = t.text(
+  pattern: "^[A-Z]{2}[0-9]{2}[A-Z0-9 ]{11,40}$",
+  pattern-doc: "an IBAN such as \"DE75512108001245126199\"",
+)
+#let _document-type = t.union(
+  t.text(
+    pattern: "^(invoice|credit-note|corrected|prepayment|self-billed|self-billed-credit-note|[0-9]{3})$",
+    pattern-doc: "\"invoice\", \"credit-note\", \"corrected\", \"prepayment\", \"self-billed\", \"self-billed-credit-note\" or a UNTDID 1001 code such as \"380\"",
+  ),
+)
+#let _notes = t.union(
+  t.text(),
+  t.array(t.union(t.text(), t.ref("note"))),
+  conv: "notes",
+)
+#let _item-id = t.union(t.text(), t.ref("item-id"))
+#let _custom = t.ref("custom")
+#let _rows = t.array(t.tagged("kind", "item", (
+  item: "item",
+  group: "group",
+  bundle: "bundle",
+)))
+// a bundle holds items and bundles (as `bundle()`), no groups
+#let _bundle-rows = t.array(t.tagged("kind", "item", (
+  item: "item",
+  bundle: "bundle",
+)))
+
+// The address keys every party has (zugferd/model.typ `_address-keys`).
+#let _address(name-bt, address-bt, city-bt, country-bt) = (
+  name: field(
+    t.lines(),
+    doc: "Name; an array prints one line per entry.",
