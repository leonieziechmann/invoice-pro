+        doc: "Remittance information; absent = the invoice number.",
+        bt: "BT-83",
+        role: "document",
+      ),
+      sender: field(
+        t.ref("seller"),
+        doc: "The seller; absent = the skeleton's letterhead. A given sender replaces it as a whole.",
+        bt: "BG-4",
