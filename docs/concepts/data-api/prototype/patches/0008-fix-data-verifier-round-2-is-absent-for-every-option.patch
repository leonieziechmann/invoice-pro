+// The bodies of the `invoice-data` functions (public/invoice-data.typ, which
+// holds their signatures and documentation): loaded only when one is called,
+// so that the package import does not parse them. Each imports what it
+// needs (`schema(kind: "result")` loads no data descriptor).
+
+#let decode(data, region) = {
+  import "input.typ": resolve-data
+  import "hydrate.typ": make-record, rates-of
+  // the value given here is the one source (inputs are not consulted)
+  let src = resolve-data(data, inputs: (:))
+  if type(src) != dictionary { return src }
+  make-record(src.raw, region: region, rates: rates-of(region))
+}
+
+#let load(read, inputs) = {
+  import "input.typ": from-inputs
+  import "hydrate.typ": make-record
+  let src = from-inputs(read: read, inputs: inputs)
+  make-record(src.raw, origin: src.origin)
+}
+
+#let check(data, region) = {
+  import "input.typ": is-record
+  let t = type(data)
+  let object-text = (
+    (t == str or t == bytes)
+      and (if t == str { data } else { str(data) })
+        .trim("\u{feff}", at: start)
+        .trim()
+        .starts-with("{")
+  )
+  let rec = if is-record(data) { data } else if (
+    t == dictionary or object-text or str(t) == "path"
+  ) { decode(data, region) } else {
+    // the decoder reports what it found instead of an object
+    import "hydrate.typ": make-record
+    make-record(if t in (str, bytes) { "text" } else { data })
+  }
+  let r = rec.value
+  let issues = r.issues.map(i => (
+    id: i.id,
+    path: i.args.at("path", default: none),
+    key: i.key,
+    message: i.message,
+    fix: i.fix,
+  ))
+  if r.fatal != none {
+    issues.insert(0, (
+      id: "schema/format",
+      path: "/format",
+      key: "schema-version",
+      message: r.fatal,
+      fix: none,
+    ))
+  }
+  (format: "invoice-pro-check/1", valid: issues.len() == 0, issues: issues)
+}
+
+#let schema(kind) = {
+  import "export.typ": json-schema
+  if kind == "data" {
+    import "schema.typ" as s
+    json-schema(s.objects, id: s.schema-id, title: "invoice-pro/1 invoice data")
+  } else if kind == "result" {
+    import "result-schema.typ" as r
+    json-schema(r.objects, root: "result", id: r.schema-id, title: r.format)
+  } else {
+    panic(
+      "variable `invoice-data.schema::kind` must be \"data\" or \"result\", found "
+        + repr(kind),
+    )
+  }
+}
