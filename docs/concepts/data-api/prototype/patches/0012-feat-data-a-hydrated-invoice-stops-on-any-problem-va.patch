+/// The strict level of a hydrated invoice (the default, `validation: auto`):
+/// any problem stops the build, with every problem listed and how to debug
+/// them in a draft; otherwise returns `issues`. Hydrated or not, the levels
+/// mean the same: only the text differs from `enforce`'s.
+/// -> array
+#let enforce-hydrated(issues) = {
+  let n = issues.len()
+  if n == 0 { return issues }
+  panic(
+    "invoice-pro found "
+      + str(n)
+      + if n == 1 { " problem" } else { " problems" }
+      + " in the hydrated invoice, which stops on any problem so that no broken invoice goes out:\n"
+      + issues
+        .enumerate()
+        .map(((i, x)) => "  " + str(i + 1) + ". " + x.message)
+        .join("\n")
+      + "\nTo debug, render the draft with --input "
+      + level-key
+      + "=draft: it marks every problem, lists them on a report page and attaches no e-invoice.",
+  )
+}
+
 /// The arguments of `payment(..)` with the `payment` section applied by the
 /// roles of schema.typ (`own`: the arguments of the call).
 /// -> dictionary
