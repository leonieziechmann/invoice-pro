 /// The issues of a hydrated invoice at `level` (root measure): `issues` and
-/// the coverage issues of the sealed sections `h` (`coverage-issues`). Under
-/// `"strict"` (the default of a hydrated invoice, `validation: auto`) any
-/// problem stops the build with every problem listed and how to debug them
-/// in a draft. The levels mean what they mean without data; only the text
-/// of the stop differs from `enforce`'s.
+/// the coverage issues of the sealed sections `h` (`coverage-issues`). The
+/// levels mean what they mean without data, but a hydrated invoice's strict
+/// stop (the default, `validation: auto`) waits for the end of the invoice
+/// (`stop`), so that it lists the findings of the layout too.
 /// -> array
-#let enforce-hydrated(issues, level, h, view) = {
+#let hydrated-issues(issues, level, h, view) = {
   if level == none { return () }
-  let issues = issues + coverage-issues(h, view)
+  issues + coverage-issues(h, view)
+}
+
+/// The strict stop of a hydrated invoice (the frame, at the end of the
+/// invoice, in context): once the layout has run (`ready`), any problem stops
+/// the build with every problem listed and how to debug them in a draft.
+/// -> none
+#let stop(ready, issues) = {
   let n = issues.len()
-  if level != "strict" or n == 0 { return issues }
+  if not ready or n == 0 { return }
   panic(
     "invoice-pro found "
       + str(n)
@@ -287,6 +293,9 @@
