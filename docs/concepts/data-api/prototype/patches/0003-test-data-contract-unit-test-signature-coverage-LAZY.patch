diff --git a/tools/contract/signature.py b/tools/contract/signature.py
new file mode 100755
index 0000000..bd97f77
--- /dev/null
+++ b/tools/contract/signature.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Signature coverage of the hydration roles (SYNTHESIS.md §4.2).
+
+A hydrated invoice() re-enters itself with arguments built by role from the
+descriptor (src/contract/schema.typ `invoice-params`). Typst cannot list a
+function's parameters, so this test parses the signature of `invoice()` in
+src/invoice.typ and fails unless every parameter is classified (design,
+document, issuer, data, body) and every classified name is a parameter. It
+also checks that src/invoice.typ passes every parameter to `hydrate(..)`.
+
+usage: signature.py [--root <repo>] [--typst <typst binary>]
+exit 0: covered; exit 1: a parameter is not classified (or vice versa).
+"""
+import argparse, json, os, re, subprocess, sys
+
+def signature(path):
+    src = open(path, encoding="utf-8").read()
+    m = re.search(r"^#let invoice\(\n(.*?)^\) = \{", src, re.S | re.M)
+    if not m: sys.exit("signature.py: no `#let invoice(` signature in " + path)
+    names = re.findall(r"^  ([a-z][a-z0-9-]*)(?::|,)", m.group(1), re.M)
+    return names, src
+
+def hydrate_call(src):
+    m = re.search(r"hydrate\(data, \((.*?)\n    \)\)", src, re.S)
+    return re.findall(r"^\s+([a-z][a-z0-9-]*): ", m.group(1), re.M) if m else []
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
+    ap.add_argument("--typst", default="typst")
+    a = ap.parse_args()
+    root = os.path.abspath(a.root)
+    params, src = signature(os.path.join(root, "src", "invoice.typ"))
+    out = subprocess.run([a.typst, "eval", "--root", root,
+                          '{ import "/src/contract/schema.typ" as s; s.invoice-params }'],
+                         capture_output=True, text=True)
+    if out.returncode != 0: sys.exit("signature.py: typst eval failed:\n" + out.stderr)
+    classes = json.loads(out.stdout)
+    problems = []
+    for p in params:
+        if p not in classes:
+            problems.append(f"invoice() parameter `{p}` has no class in src/contract/schema.typ "
+                            "(`invoice-params`: design | document | issuer | data | body); "
+                            "a hydrated invoice would drop or ignore it")
+    for k in classes:
+        if k not in params:
+            problems.append(f"`{k}` is classified in src/contract/schema.typ but is no parameter of invoice()")
+    passed = hydrate_call(src)
+    for p in params:
+        if p not in ("data", "body") and p not in passed:
+            problems.append(f"invoice() does not pass `{p}` to hydrate(..) in src/invoice.typ")
+    for line in problems: print("FAIL " + line)
+    if not problems:
+        roles = {}
+        for k, v in classes.items(): roles.setdefault(v, []).append(k)
+        print(f"ok: {len(params)} invoice() parameters, all classified: "
+              + ", ".join(f"{k} {len(v)}" for k, v in sorted(roles.items())))
+    sys.exit(1 if problems else 0)
+
+main()
