 src/contract/schema.typ              |   3 +-
 tests/data/conformance/fixtures.json | 346 +++++++++++++++++++++++++++
 tests/data/contract/test.typ         |   7 +
 4 files changed, 356 insertions(+), 1 deletion(-)

diff --git a/src/contract/invoice.schema.json b/src/contract/invoice.schema.json
index 728004f..6e3fb6e 100644
--- a/src/contract/invoice.schema.json
+++ b/src/contract/invoice.schema.json
@@ -3348,6 +3348,7 @@
         "days": {
           "type": "integer",
           "minimum": 1,
+          "maximum": 36500,
           "description": "Days.",
           "x-invoice-pro-since": "1.0"
         },
diff --git a/src/contract/schema.typ b/src/contract/schema.typ
index 253cac5..34408e5 100644
--- a/src/contract/schema.typ
+++ b/src/contract/schema.typ
@@ -838,7 +838,8 @@
     ),
   ),
   cash-discount: object(doc: "A cash discount.", (
-    days: field(t.integer(min: 1), doc: "Days.", required: true),
+    // at most 100 years, as the payment days
+    days: field(t.integer(min: 1, max: 36500), doc: "Days.", required: true),
     percent: field(
       t.percent(min: 0%, max: 100%, exclusive: true, digits: 2),
       doc: "Percentage, more than 0% and less than 100%, with at most 2 decimals.",
