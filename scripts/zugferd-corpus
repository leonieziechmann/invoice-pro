#!/usr/bin/env bash
# E-invoice conformance corpus: checks that every business term of EN 16931
# has a disposition (tools/zugferd/bt_disposition.py) and every rule id of the
# official validators a class (tools/zugferd/rule_coverage.py), generates the
# corpus of invoices (tools/zugferd/corpus/gen.py), then compiles every case
# once and compares invoice-pro's own verdict and the XML with the official
# validators (XSD, Mustang and KoSIT) and the semantic oracles
# (tools/zugferd/run.py).
# See tests/TESTING.md, "E-invoice conformance and performance (CI)".
#
# Usage: zugferd-corpus [--population pr|nightly|legal] [run.py options ...]
#        e.g. zugferd-corpus --jobs 4 --only 'pw01*'
#
# Needs Python 3.11+ with lxml and pypdf ($PYTHON, default python3), Typst
# ($TYPST_BIN, default typst), a JDK ($JAVA_BIN/$JAVAC_BIN or $JAVA_HOME,
# default java/javac), the Mustang CLI jar 2.14.0 ($MUSTANG_JAR), the KoSIT
# validator jar 1.6.3 ($KOSIT_JAR) and its unpacked XRechnung configuration
# ($KOSIT_CONFIG). The Nix app `nix run .#zugferd-corpus` provides all of them.
set -euo pipefail

if [ ! -f "typst.toml" ]; then
  echo "Error: zugferd-corpus must be run from the root of the invoice-pro repository." >&2
  exit 1
fi

PYTHON="${PYTHON:-python3}"
population="pr"
run_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --population)
      population="$2"
      shift 2
      ;;
    --population=*)
      population="${1#*=}"
      shift
      ;;
    *)
      run_args+=("$1")
      shift
      ;;
  esac
done

# The tools check themselves first: classification, report parsing, oracles,
# generator constraints (a few seconds, no Typst or Java).
"$PYTHON" -m unittest discover --quiet -s tools/zugferd -p 'test_*.py'
# Every business term of EN 16931 has a disposition: an input, a derivation
# or a reason why it is not supported (tools/zugferd/bt-disposition.toml).
"$PYTHON" tools/zugferd/bt_disposition.py
# The tables of the XML write guard are those the generator compiles from the
# pinned artefacts and src/zugferd/build.typ (drift test), and the guard
# passes the mutation test against the XSD and Mustang (tests/TESTING.md);
# the nightly run takes more mutants and compares them with KoSIT as well.
"$PYTHON" tools/zugferd/gen_guard.py --check
if [ "$population" = "nightly" ]; then
  "$PYTHON" tools/zugferd/mutate.py --per-operator 4 --kosit
else
  "$PYTHON" tools/zugferd/mutate.py
fi
# Every rule id of the official validators has a class in
# tools/zugferd/rule-coverage.toml, every IP rule its basis and tests, and
# the table in docs/docs/e-invoicing.md the numbers; run.py then checks that
# the parity fixtures (tools/zugferd/corpus/rules/) pass.
"$PYTHON" tools/zugferd/rule_coverage.py --json build/zugferd/rule-coverage.json
"$PYTHON" tools/zugferd/corpus/gen.py --population "$population"
exec "$PYTHON" tools/zugferd/run.py ${run_args[@]+"${run_args[@]}"}
