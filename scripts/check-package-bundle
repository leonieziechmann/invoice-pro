#!/usr/bin/env bash
# Package bundle check: the package works on its own, with exactly the files
# a Typst Universe release publishes.
#
# 1. Copies the files .github/workflows/publish-package.yaml publishes
#    (`files:`) into a temporary package directory and removes what the
#    `exclude` globs of typst.toml leave out of the bundle.
# 2. Adds the Typst Universe packages the bundle imports (and theirs), from
#    the package path or cache of Typst; one that is in neither is downloaded
#    once.
# 3. Offline, and with that directory as the only package source, creates a
#    project from the template (`typst init`) and compiles it, then compiles
#    the e-invoice documents below against `@preview/invoice-pro:<version>`.
#    Downloads fail (they go to an unreachable proxy), the repository is not
#    the Typst root, and no other tool runs: a file the bundle lacks, e.g. one
#    of tools/ or tests/, stops the compilation.
# 4. Prints the size of the bundle and of its largest source files.
#
# Usage: check-package-bundle [--keep DIR]   (--keep: keep the bundle in DIR)
#
# Needs Typst ($TYPST_BIN, default typst) and coreutils; `nix run
# .#check-package-bundle` provides them. See tests/TESTING.md.
set -euo pipefail

if [ ! -f "typst.toml" ]; then
  echo "Error: check-package-bundle must be run from the root of the invoice-pro repository." >&2
  exit 1
fi

TYPST="${TYPST_BIN:-typst}"
keep=""
if [ "${1:-}" = "--keep" ]; then
  keep="${2:?--keep needs a directory}"
fi

# E-invoice documents compiled against the bundle, besides the template. They
# import /src/lib.typ, which becomes the import of the package.
DOCUMENTS=(
  "tests/docs/e-invoicing-sepa-debit/test.typ" # XRechnung, SEPA direct debit
  "tests/docs/e-invoicing-report/test.typ"     # "report" mode, a theme's report
)

toml_value() {
  sed -nE "s/^$1[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\1/p" typst.toml | sed -n '1p'
}
name="$(toml_value name)"
version="$(toml_value version)"
files="$(sed -nE 's/^[[:space:]]*files:[[:space:]]*"([^"]+)".*/\1/p' .github/workflows/publish-package.yaml)"
if [ -z "$name" ] || [ -z "$version" ] || [ -z "$files" ]; then
  echo "Error: cannot read the package name and version (typst.toml) or the published files (.github/workflows/publish-package.yaml)." >&2
  exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
packages="$work/packages"
bundle="$packages/preview/$name/$version"
mkdir -p "$bundle" "$work/empty-cache"

# --- 1. The published files, without the `exclude` globs of typst.toml ---
for file in $files; do
  if [ ! -e "$file" ]; then
    echo "Error: $file, which publish-package.yaml publishes, does not exist." >&2
    exit 1
  fi
  cp -R "$file" "$bundle/"
done
# The `exclude` list is read from its line; a list over several lines would
# be read as empty and leave excluded files in the bundle, so it stops here.
exclude_line="$(grep -E '^exclude[[:space:]]*=' typst.toml || true)"
if [ -n "$exclude_line" ] && [ "${exclude_line%]*}" = "$exclude_line" ]; then
  echo "Error: the \`exclude\` list of typst.toml spans several lines; write it on one line so that this check can read it." >&2
  exit 1
fi
excludes="$(printf '%s\n' "$exclude_line" | sed -nE 's/^exclude[[:space:]]*=[[:space:]]*\[(.*)\].*/\1/p' | tr ',' '\n' |
  sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//' | sed '/^$/d')"
(
  cd "$bundle"
  shopt -s globstar nullglob dotglob
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    # A leading slash anchors the glob at the package root, like .gitignore.
    if [ "${pattern#/}" != "$pattern" ]; then glob="${pattern#/}"; else glob="**/$pattern"; fi
    for match in $glob; do rm -rf "$match"; done
  done <<<"$excludes"
)

# --- 2. The Typst Universe packages the bundle imports ---
imports_of() {
  grep -rhoE '@preview/[a-z0-9-]+:[0-9]+\.[0-9]+\.[0-9]+' --include='*.typ' "$1" | sort -u || true
}
# The package path and cache of this Typst, where downloaded packages are
# (`typst info` writes to standard error).
sources="$("$TYPST" info 2>&1 | sed -nE 's/^[[:space:]]*Package (cache )?path[[:space:]]+//p' || true)"
find_package() {
  local dir
  while IFS= read -r dir; do
    if [ -n "$dir" ] && [ -f "$dir/preview/$1/$2/typst.toml" ]; then
      printf '%s\n' "$dir/preview/$1/$2"
      return 0
    fi
  done <<<"$sources"
  return 1
}
mapfile -t pending < <(imports_of "$bundle" | grep -v "^@preview/$name:" || true)
dependencies=()
while [ ${#pending[@]} -gt 0 ]; do
  spec="${pending[0]}"
  pending=("${pending[@]:1}")
  dep="${spec#@preview/}"
  dep_name="${dep%%:*}"
  dep_version="${dep#*:}"
  target="$packages/preview/$dep_name/$dep_version"
  [ -d "$target" ] && continue
  if ! found="$(find_package "$dep_name" "$dep_version")"; then
    echo "Downloading $spec once (it is in neither the package path nor the cache of Typst)..."
    printf '#import "%s"\n' "$spec" >"$work/fetch.typ"
    "$TYPST" compile --root "$work" "$work/fetch.typ" "$work/fetch.pdf" >/dev/null 2>&1 || true
    if ! found="$(find_package "$dep_name" "$dep_version")"; then
      echo "Error: the dependency $spec is not available (see the output of \`typst info\`)." >&2
      exit 1
    fi
  fi
  mkdir -p "$(dirname "$target")"
  cp -R "$found" "$target"
  dependencies+=("$spec")
  mapfile -t imports < <(imports_of "$target")
  pending+=("${imports[@]}")
done

# --- 3. Offline compilation against the bundle ---
offline=(--package-path "$packages" --package-cache-path "$work/empty-cache")
compile=(compile --pdf-standard=a-3b --creation-timestamp 315532800 "${offline[@]}")
# Every download goes to a port nobody listens on, so it fails.
proxy=http://127.0.0.1:9
export HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" ALL_PROXY="$proxy" https_proxy="$proxy" http_proxy="$proxy" all_proxy="$proxy"
export NO_PROXY="" no_proxy=""

echo "========================"
echo " Checking the package bundle of $name $version... "
echo "========================"
echo "Published files: $files"
echo "Dependencies: ${dependencies[*]:-none}"

project="$work/project"
if ! output="$("$TYPST" init "@preview/$name:$version" "$project" "${offline[@]}" 2>&1)"; then
  echo "$output" >&2
  exit 1
fi
entrypoint="$(sed -nE '/^\[template\]/,/^\[/ s/^entrypoint[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' typst.toml)"
echo "Compiling the template ($entrypoint)..."
"$TYPST" "${compile[@]}" --root "$project" "$project/$entrypoint" "$work/template.pdf"

mkdir -p "$work/documents"
for document in "${DOCUMENTS[@]}"; do
  echo "Compiling $document against @preview/$name:$version..."
  copy="$work/documents/$(printf '%s' "${document%.typ}" | tr -c 'A-Za-z0-9._-' '_').typ"
  sed "s|\"/src/lib.typ\"|\"@preview/$name:$version\"|" "$document" >"$copy"
  if ! grep -q "@preview/$name:$version" "$copy"; then
    echo "Error: $document does not import /src/lib.typ." >&2
    exit 1
  fi
  "$TYPST" "${compile[@]}" --root "$work/documents" "$copy" "${copy%.typ}.pdf"
done

# --- 4. Sizes ---
kib() { awk -v bytes="$1" 'BEGIN { printf "%.1f KiB", bytes / 1024 }'; }
bundle_bytes="$(find "$bundle" -type f -exec cat {} + | wc -c)"
bundle_files="$(find "$bundle" -type f | wc -l | tr -d ' ')"
src_bytes="$(find "$bundle/src" -type f -exec cat {} + | wc -c)"
src_files="$(find "$bundle/src" -type f | wc -l | tr -d ' ')"
echo ""
echo "Bundle: $bundle_files files, $(kib "$bundle_bytes"); src/: $src_files files, $(kib "$src_bytes")"
echo "Largest source files:"
# `sed -n` reads all its input: `head` would stop early, and `sort` could die
# of SIGPIPE, which `set -o pipefail` turns into a failure of the script.
(cd "$bundle" && find src -type f -exec wc -c {} + | grep -v '[[:space:]]total$' | sort -rn | sed -n '1,10p') |
  while read -r bytes file; do
    printf '  %10s  %s\n' "$(kib "$bytes")" "$file"
  done

if [ -n "$keep" ]; then
  mkdir -p "$keep"
  cp -R "$packages/." "$keep/"
  echo "Kept the bundle and its dependencies in $keep."
fi

echo ""
echo "✔ The package compiles on its own from the published files."
