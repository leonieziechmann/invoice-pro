#!/usr/bin/env bash
set -e

if [ ! -f "typst.toml" ]; then
  echo "Error: check-version must be run from the root of the invoice-pro repository." >&2
  exit 1
fi

RG="${RIPGREP_BIN:-rg}"

CURRENT_VERSION="${VERSION:-$(grep -E '^version\s*=' typst.toml | sed -E 's/version\s*=\s*"([^"]+)"/\1/')}"

EXCLUDE="-g '!docs/versioned_docs/' -g '!docs/versioned_sidebars/' -g '!docs/build/' -g '!docs/node_modules/' -g '!docs/.docusaurus/'"
GLOBS="-g '*.typ' -g '*.md' -g '*.toml'"

echo "Current version: $CURRENT_VERSION"
echo ""
echo "Searching for stale version references..."
echo "==========================================="

if [ -z "$1" ]; then
  echo "Usage: check-version <old-version>"
  echo "  e.g. check-version 0.3.0"
  exit 1
fi

OLD="$1"
echo ""
echo "--- Stale references to $OLD (should be empty) ---"
eval "\"$RG\" \"$OLD\" $GLOBS $EXCLUDE" || echo "  ✔ No stale references found."
echo ""
echo "--- Current references to $CURRENT_VERSION ---"
eval "\"$RG\" \"$CURRENT_VERSION\" $GLOBS $EXCLUDE"
