#!/usr/bin/env bash
set -e

if [ ! -f "typst.toml" ]; then
  echo "Error: validate-zugferd must be run from the root of the invoice-pro repository." >&2
  exit 1
fi

if [ -z "$1" ]; then
  echo "Usage: validate-zugferd <typst-document> [output-path]" >&2
  exit 1
fi

TYPST="${TYPST_BIN:-typst}"
PDFDETACH="${PDFDETACH_BIN:-pdfdetach}"
MUSTANG="${MUSTANG_CLI_BIN:-mustang-cli}"

src_file="$1"
output_path="$2"

tmp_dir=$(mktemp -d)
# Cleanup temp dir on exit unless it is empty/deleted
trap 'rm -rf "$tmp_dir"' EXIT

if [ -n "$output_path" ]; then
  pdf_path="$output_path"
elif [ -n "${ZUGFERD_PDF_DIR:-}" ]; then
  # Keep the PDF for later checks, named after the document
  # (scripts/validate-all-zugferd validates them with KoSIT).
  mkdir -p "$ZUGFERD_PDF_DIR"
  name=$(printf '%s' "${src_file%.typ}" | tr -c 'A-Za-z0-9._-' '_')
  pdf_path="$ZUGFERD_PDF_DIR/$name.pdf"
else
  name=$(basename "$src_file" .typ)
  pdf_path="$tmp_dir/$name.pdf"
fi

extract_dir="$tmp_dir/extracted"
mkdir -p "$extract_dir"

echo "Compiling ZUGFeRD PDF for $src_file..."
"$TYPST" compile \
  --root . \
  --pdf-standard=a-3b \
  "$src_file" \
  "$pdf_path"

echo "Extracting the e-invoice XML..."
"$PDFDETACH" -saveall -o "$extract_dir" "$pdf_path"

# The name of the attached XML: factur-x.xml, or xrechnung.xml for the
# XRECHNUNG profile of ZUGFeRD.
xml_path=""
for name in factur-x.xml xrechnung.xml; do
  if [ -f "$extract_dir/$name" ]; then
    xml_path="$extract_dir/$name"
    break
  fi
done
if [ -z "$xml_path" ]; then
  echo "Error: no factur-x.xml or xrechnung.xml found in the compiled PDF!" >&2
  exit 1
fi

echo "Validating ZUGFeRD XML ($(basename "$xml_path"))..."
"$MUSTANG" --action validate --source "$xml_path"
